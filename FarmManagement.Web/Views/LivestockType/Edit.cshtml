@model FarmManagement.Application.DTOs.Livestocks.UpdateLivestockTypeDto

@{
    ViewData["Title"] = "Sửa loại vật nuôi";

    // Breadcrumbs
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        new BreadcrumbItem("Loại vật nuôi", "/LivestockType", "bi bi-collection"),
        BreadcrumbItem.Current("Chỉnh sửa")
    );

    // Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = "Sửa loại vật nuôi",
        Subtitle = $"Cập nhật thông tin #{Model.Id}",
        Icon = "bi bi-collection",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            ActionButtonModel.Back("/LivestockType", "Quay lại")
        }
    };
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

<div class="row g-4">
    @* ==================== Main Form ==================== *@
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi bi-pencil text-primary me-2"></i>Thông tin loại vật nuôi
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-tag me-1 text-muted"></i>Tên loại <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-text-paragraph me-1 text-muted"></i>Mô tả
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" role="switch" />
                                <label asp-for="IsActive" class="form-check-label">
                                    <i class="bi bi-toggle-on me-1"></i>Trạng thái hoạt động
                                </label>
                            </div>
                            <div class="form-text">Bật để cho phép sử dụng loại vật nuôi này</div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ==================== Sidebar - Info ==================== *@
    <div class="col-lg-4">
        @* Info Card *@
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi bi-info-circle text-primary me-2"></i>Thông tin
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">ID</small>
                    <strong>@Model.Id</strong>
                </div>
                <div>
                    <small class="text-muted d-block">Trạng thái hiện tại</small>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success">
                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary">
                            <i class="bi bi-x-circle me-1"></i>Không hoạt động
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Danger Zone *@
        <div class="card border-danger">
            <div class="card-header bg-danger-subtle border-danger">
                <h6 class="card-title mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>Vùng nguy hiểm
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">Các thao tác không thể hoàn tác</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa loại vật nuôi này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-trash me-1"></i>Xóa loại vật nuôi này
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .bg-primary-subtle {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    .bg-secondary-subtle {
        background-color: rgba(108, 117, 125, 0.1) !important;
    }

    .bg-danger-subtle {
        background-color: rgba(220, 53, 69, 0.1) !important;
    }
</style>
