@model FarmManagement.Application.DTOs.Livestocks.CreateLivestockTypeDto

@{
    ViewData["Title"] = "Thêm loại vật nuôi";

    // Breadcrumbs
    ViewData.SetBreadcrumbs(
   BreadcrumbItem.Home(),
     new BreadcrumbItem("Loại vật nuôi", "/LivestockType", "bi bi-collection"),
   BreadcrumbItem.Current("Thêm mới")
    );

    // Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = "Thêm loại vật nuôi",
        Subtitle = "Tạo loại vật nuôi mới trong hệ thống",
        Icon = "bi bi-collection",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
 {
     ActionButtonModel.Back("/LivestockType", "Quay lại")
    }
    };
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

<div class="row g-4">
    @* ==================== Main Form ==================== *@
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi bi-collection text-primary me-2"></i>Thông tin loại vật nuôi
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label">
                                <i class="bi bi-hash me-1 text-muted"></i>Mã loại <span class="text-muted">(tùy chọn)</span>
                            </label>
                            <input asp-for="Code" class="form-control" placeholder="VD: PIG, COW, CHICKEN..." />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                            <div class="form-text">Để trống hệ thống sẽ tự tạo</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-tag me-1 text-muted"></i>Tên loại <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="VD: Heo, Bò, Gà..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-text-paragraph me-1 text-muted"></i>Mô tả
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả chi tiết về loại vật nuôi này..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Lưu
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ==================== Sidebar - Hints ==================== *@
    <div class="col-lg-4">
        <div class="card bg-primary-subtle border-primary">
            <div class="card-header bg-transparent border-primary">
                <h6 class="card-title mb-0 text-primary">
                    <i class="bi bi-lightbulb me-2"></i>Gợi ý
                </h6>
            </div>
            <div class="card-body">
                <p class="mb-3 text-muted">Một số loại vật nuôi phổ biến:</p>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><i class="bi bi-check text-primary me-2"></i>Heo / Lợn</li>
                    <li class="mb-2"><i class="bi bi-check text-primary me-2"></i>Bò / Trâu</li>
                    <li class="mb-2"><i class="bi bi-check text-primary me-2"></i>Gà / Vịt</li>
                    <li class="mb-2"><i class="bi bi-check text-primary me-2"></i>Dê / Cừu</li>
                    <li><i class="bi bi-check text-primary me-2"></i>Cá / Tôm</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .bg-primary-subtle {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }
</style>
