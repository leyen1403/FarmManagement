@model List<FarmManagement.Application.DTOs.Livestocks.LivestockDto>
@using FarmManagement.Application.DTOs.Livestocks
@using FarmManagement.Application.DTOs.Locations

@{
    ViewData["Title"] = "Quản lý vật nuôi";

    // Breadcrumbs
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        BreadcrumbItem.Current("Vật nuôi", "bi bi-bug")
    );

    var livestockTypes = ViewBag.LivestockTypes as List<LivestockTypeDto> ?? new List<LivestockTypeDto>();
    var livestockStatuses = ViewBag.LivestockStatuses as List<LivestockStatusDto> ?? new List<LivestockStatusDto>();
    var locations = ViewBag.Locations as List<LocationDto> ?? new List<LocationDto>();

    int? selectedLivestockTypeId = ViewBag.SelectedLivestockTypeId;
    int? selectedLivestockStatusId = ViewBag.SelectedLivestockStatusId;
    int? selectedLocationId = ViewBag.SelectedLocationId;
    var searchTerm = Context.Request.Query["searchTerm"].ToString();

 var totalQuantity = Model.Sum(x => x.Quantity);
    var totalMale = Model.Sum(x => x.MaleCount);
    var totalFemale = Model.Sum(x => x.FemaleCount);
    var totalWeight = Model.Sum(x => x.TotalImportWeight);
    var totalPrice = Model.Sum(x => x.TotalImportPrice);

    // Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = "Quản lý vật nuôi",
        Subtitle = "Theo dõi và quản lý vật nuôi trong trang trại",
  Icon = "bi bi-bug",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            new ActionButtonModel("Xuất Excel", "#", "bi bi-file-earmark-excel", "btn-outline-success") { Size = ButtonSize.Small },
         ActionButtonModel.Create("/Livestock/Create", "Thêm vật nuôi")
   }
    };

    // Stats Cards
    var statsCards = new List<StatsCardModel>
  {
        new StatsCardModel
        {
     Value = totalQuantity.ToString("N0"),
     Label = "Tổng số con",
      Icon = "bi bi-bug",
   IconBackgroundClass = "bg-primary-subtle",
         ColorClass = "text-primary",
       TrendDescription = $"♂ {totalMale} đực | ♀ {totalFemale} cái"
 },
 new StatsCardModel
        {
            Value = Model.Count.ToString(),
      Label = "Đàn/Lô vật nuôi",
 Icon = "bi bi-collection",
            IconBackgroundClass = "bg-info-subtle",
      ColorClass = "text-info"
   },
  new StatsCardModel
        {
            Value = totalWeight.ToString("N0"),
      Label = "Tổng trọng lượng (kg)",
   Icon = "bi bi-speedometer2",
        IconBackgroundClass = "bg-success-subtle",
         ColorClass = "text-success"
      },
        new StatsCardModel
        {
            Value = totalPrice.ToString("N0"),
 Label = "Tổng giá trị (VNĐ)",
            Icon = "bi bi-currency-dollar",
   IconBackgroundClass = "bg-warning-subtle",
       ColorClass = "text-warning"
        }
    };

    // Filter Form
    var filterForm = new FilterFormModel
    {
        ActionUrl = "/Livestock",
 Method = "GET",
        Title = "Bộ lọc tìm kiếm",
   Icon = "bi bi-funnel",
        IsExpanded = !string.IsNullOrEmpty(searchTerm) || selectedLivestockTypeId.HasValue || selectedLivestockStatusId.HasValue || selectedLocationId.HasValue,
        ResetUrl = "/Livestock",
     ColumnsPerRow = 4,
Fields = new List<FilterFieldModel>
     {
            new FilterFieldModel
        {
      Name = "searchTerm",
     Label = "Tìm kiếm",
 Type = FilterFieldType.Text,
       Value = searchTerm,
    Placeholder = "Tên, mã thẻ...",
       Icon = "bi bi-search",
     ColSpan = 3
        },
   new FilterFieldModel
         {
      Name = "livestockTypeId",
             Label = "Loại vật nuôi",
            Type = FilterFieldType.Select,
         Value = selectedLivestockTypeId?.ToString(),
     Placeholder = "Tất cả loại",
       ColSpan = 3,
      Options = livestockTypes.Select(t => new SelectOptionModel(t.Id.ToString(), t.Name, t.Id == selectedLivestockTypeId)).ToList()
         },
            new FilterFieldModel
          {
        Name = "livestockStatusId",
         Label = "Trạng thái",
     Type = FilterFieldType.Select,
           Value = selectedLivestockStatusId?.ToString(),
          Placeholder = "Tất cả trạng thái",
         ColSpan = 3,
 Options = livestockStatuses.Select(s => new SelectOptionModel(s.Id.ToString(), s.Name, s.Id == selectedLivestockStatusId)).ToList()
        },
         new FilterFieldModel
            {
   Name = "locationId",
      Label = "Vị trí",
    Type = FilterFieldType.Select,
           Value = selectedLocationId?.ToString(),
       Placeholder = "Tất cả vị trí",
       ColSpan = 3,
       Options = locations.Select(l => new SelectOptionModel(l.Id.ToString(), l.Name, l.Id == selectedLocationId)).ToList()
          }
        }
};

    // Delete Modal
    var deleteModal = DeleteModalModel.ForEntity("vật nuôi", "Livestock");
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

@* ==================== Stats Cards ==================== *@
<partial name="_StatsCards" model="statsCards" />

@* ==================== Filter Form ==================== *@
<partial name="_FilterForm" model="filterForm" />

@* ==================== Data Table ==================== *@
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <div class="d-flex align-items-center gap-2">
 <h6 class="card-title mb-0 fw-semibold">
        <i class="bi bi-list-ul text-primary me-2"></i>Danh sách vật nuôi
         </h6>
  <span class="badge bg-primary">@Model.Count lô</span>
        </div>
        <div class="d-flex align-items-center gap-2">
      <div class="input-group input-group-sm" style="width: 250px;">
          <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
       <input type="text" class="form-control" id="quickSearch" placeholder="Tìm nhanh trong bảng...">
</div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="livestockTable">
                <thead class="bg-light">
       <tr>
             <th width="50" class="text-center">#</th>
        <th>Tên/Mã thẻ</th>
             <th width="130">Loại</th>
     <th width="120">Số lượng</th>
     <th width="140">Vị trí</th>
            <th width="110">Ngày nhập</th>
     <th width="110">Trọng lượng</th>
      <th width="130">Giá trị</th>
            <th width="120">Trạng thái</th>
            <th width="130" class="text-center">Thao tác</th>
        </tr>
       </thead>
     <tbody>
             @{ var index = 0; }
     @foreach (var item in Model)
  {
      index++;
                <tr>
     <td class="text-center text-muted">@index</td>
     <td>
     <div class="d-flex align-items-center gap-3">
      <div class="livestock-icon bg-primary-subtle text-primary rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                     <i class="bi bi-bug"></i>
      </div>
             <div>
<div class="fw-semibold">@(item.Name ?? item.TagCode ?? $"VN-{item.Id:D4}")</div>
       @if (!string.IsNullOrEmpty(item.TagCode) && !string.IsNullOrEmpty(item.Name))
     {
               <small class="text-muted">Mã: @item.TagCode</small>
}
     </div>
        </div>
    </td>
        <td>
    <span class="badge bg-info-subtle text-info">
               <i class="bi bi-tag me-1"></i>@item.LivestockTypeName
                    </span>
    </td>
              <td>
            <div>
             <span class="fw-semibold">@item.Quantity con</span>
         @if (item.MaleCount > 0 || item.FemaleCount > 0)
  {
             <small class="d-block text-muted">
     <i class="bi bi-gender-male text-primary"></i> @item.MaleCount |
 <i class="bi bi-gender-female text-danger"></i> @item.FemaleCount
              </small>
        }
         </div>
           </td>
                 <td>
           <span class="text-muted">
   <i class="bi bi-geo-alt me-1"></i>@item.LocationName
    </span>
                 </td>
        <td>
           <small class="text-muted">
       <i class="bi bi-calendar me-1"></i>@item.ImportDate.ToString("dd/MM/yyyy")
  </small>
                </td>
            <td>
 <div>
       <span class="fw-medium">@item.TotalImportWeight.ToString("N1") kg</span>
       @if (item.Quantity > 1)
    {
          <small class="d-block text-muted">~@item.ImportWeight.ToString("N1") kg/con</small>
    }
     </div>
                </td>
                 <td>
 <div>
        <span class="fw-medium text-success">@item.TotalImportPrice.ToString("N0")₫</span>
    @if (item.Quantity > 1)
       {
    <small class="d-block text-muted">~@item.ImportPrice.ToString("N0")₫/con</small>
     }
     </div>
              </td>
       <td>
          @{
   var statusClass = item.LivestockStatusName switch
          {
      var s when s?.Contains("nuôi") == true => "success",
         var s when s?.Contains("Bán") == true => "warning",
      var s when s?.Contains("Chết") == true || s?.Contains("mổ") == true => "danger",
             var s when s?.Contains("Bệnh") == true || s?.Contains("Cách ly") == true => "warning",
     _ => "secondary"
         };
 }
   <span class="badge bg-@statusClass-subtle text-@statusClass">
      <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
             @item.LivestockStatusName
                  </span>
          </td>
     <td class="text-center">
      <partial name="_ActionButtons" model="@(new ActionButtonsModel(item.Id, "Livestock", item.Name ?? item.TagCode ?? $"VN-{item.Id:D4}") { ShowDetails = true })" />
</td>
       </tr>
          }
        </tbody>
   </table>
 </div>
    }
    else
    {
        <partial name="_EmptyState" model="@(EmptyStateModel.NoData("vật nuôi", "/Livestock/Create"))" />
    }
</div>

@* ==================== Delete Modal ==================== *@
<partial name="_DeleteModal" model="deleteModal" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
     // Initialize DataTable
            FarmApp.DataTable.init('#livestockTable', {
         searchInput: '#quickSearch',
    sortable: true,
         highlightMatches: true,
          searchableColumns: [1, 2, 4, 8] // Name, Type, Location, Status
 });

            // Initialize tooltips
     FarmApp.UI.initTooltips();
        });
    </script>
}

<style>
    .livestock-icon { flex-shrink: 0; }
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1) !important; }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1) !important; }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.15) !important; }
    .bg-info-subtle { background-color: rgba(13, 202, 240, 0.1) !important; }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1) !important; }
.bg-secondary-subtle { background-color: rgba(108, 117, 125, 0.1) !important; }
</style>
