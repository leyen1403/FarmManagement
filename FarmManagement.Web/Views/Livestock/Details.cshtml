@* Hidden data for sales details *@
<script id="salesDetailsData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sales.Select(s => new {
        id = s.Id,
        details = s.Details.Select(d => new {
            id = d.Id,
            gender = (int)d.Gender,
            quantity = d.Quantity,
            weight = d.Weight,
            unitPrice = d.UnitPrice,
            note = d.Note
        })
    })))
</script>

<style>
    .info-box { transition: all 0.2s ease; }
    .info-box:hover { background-color: var(--bs-light); }
    .nav-tabs .nav-link { color: var(--bs-secondary); border-bottom: 2px solid transparent; }
    .nav-tabs .nav-link.active { font-weight: 600; border-bottom-color: var(--bs-primary); color: var(--bs-primary); }
    .nav-tabs .nav-link:hover { border-bottom-color: var(--bs-gray-400); }
    .hover-shadow:hover { box-shadow: 0 .125rem .25rem rgba(0,0,0,.075); }
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1) !important; }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1) !important; }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.15) !important; }
    .bg-info-subtle { background-color: rgba(13, 202, 240, 0.1) !important; }
