          <input type="date" name="EffectiveFrom" id="editPriceEffectiveFrom" class="form-control" required />
</div>
       <div class="col-md-6">
          <label class="form-label">Ngày kết thúc</label>
               <input type="date" name="EffectiveTo" id="editPriceEffectiveTo" class="form-control" />
        </div>
             <div class="col-12">
     <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editPriceIsActive" />
         <label class="form-check-label" for="editPriceIsActive">Hoạt động</label>
  </div>
         </div>
 <div class="col-12">
 <label class="form-label">Ghi chú</label>
  <textarea name="Note" id="editPriceNote" class="form-control" rows="2"></textarea>
     </div>
      </div>
