@section Scripts {
    <script>
        let rowIndex = 0;
        let editRowIndex = 0;
   const livestockId = @Model.Id;

// Preload prices for quick lookup
        const pricesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prices.Select(p => new { gender = (int)p.Gender, unitPrice = p.UnitPrice, isActive = p.IsActive })));

        // Load sales details data
   const salesDetailsData = JSON.parse(document.getElementById('salesDetailsData').textContent);

        // Helper to get price from preloaded data
        function getPreloadedPrice(gender) {
       const price = pricesData.find(p => p.gender == gender && p.isActive);
         return price ? price.unitPrice : 0;
   }

        // Helper to fetch active price from API (fallback)
        async function fetchActivePrice(livestockId, gender, atDate) {
            try {
 const params = new URLSearchParams({ livestockId: livestockId, gender: gender });
        if (atDate) params.append('at', new Date(atDate).toISOString());
    const res = await fetch(`/api/LivestockPrices/active?${params.toString()}`);
   if (!res.ok) return null;
      return await res.json();
      } catch (e) {
          console.error('Fetch price error', e);
         return null;
       }
        }

      // Open Edit Price Modal
        function openEditPriceModal(id, gender, unitPrice, effectiveFrom, effectiveTo, isActive, note) {
            document.getElementById('editPriceId').value = id;
            document.getElementById('editPriceGender').value = gender;
      document.getElementById('editPriceUnitPrice').value = unitPrice;
   document.getElementById('editPriceEffectiveFrom').value = effectiveFrom;
          document.getElementById('editPriceEffectiveTo').value = effectiveTo || '';
            document.getElementById('editPriceIsActive').checked = isActive;
 document.getElementById('editPriceNote').value = note || '';

   var modal = new bootstrap.Modal(document.getElementById('editPriceModal'));
        modal.show();
        }

        // Open Edit Care Log Modal
        function openEditCareLogModal(id, typeId, careDate, quantity, unit, cost, note) {
          document.getElementById('editCareLogId').value = id;
document.getElementById('editCareLogTypeId').value = typeId;
            document.getElementById('editCareLogDate').value = careDate;
            document.getElementById('editCareLogQuantity').value = quantity;
    document.getElementById('editCareLogUnit').value = unit || '';
  document.getElementById('editCareLogCost').value = cost;
     document.getElementById('editCareLogNote').value = note || '';

     var modal = new bootstrap.Modal(document.getElementById('editCareLogModal'));
   modal.show();
        }

 // Open Edit Health Log Modal
        function openEditHealthLogModal(id, statusId, checkDate, symptom, treatment, medicineCost, vetName) {
      document.getElementById('editHealthLogId').value = id;
  document.getElementById('editHealthLogStatusId').value = statusId;
     document.getElementById('editHealthLogCheckDate').value = checkDate;
    document.getElementById('editHealthLogSymptom').value = symptom || '';
      document.getElementById('editHealthLogTreatment').value = treatment || '';
            document.getElementById('editHealthLogMedicineCost').value = medicineCost;
  document.getElementById('editHealthLogVetName').value = vetName || '';

      var modal = new bootstrap.Modal(document.getElementById('editHealthLogModal'));
 modal.show();
        }

        // Open Edit Sale Modal
        function openEditSaleModal(id, saleDate, buyer, buyerPhone, note) {
    document.getElementById('editSaleId').value = id;
     document.getElementById('editSaleDate').value = saleDate;
          document.getElementById('editSaleBuyer').value = buyer || '';
   document.getElementById('editSaleBuyerPhone').value = buyerPhone || '';
    document.getElementById('editSaleNote').value = note || '';

            // Load existing sale details
        const saleData = salesDetailsData.find(s => s.id == id);
            const tbody = document.getElementById('editSaleDetailsBody');
 tbody.innerHTML = '';
      editRowIndex = 0;

  if (saleData && saleData.details) {
              saleData.details.forEach(detail => {
                addEditSaleDetailRow(detail);
            });
            } else {
 addEditSaleDetailRow();
       }

    var modal = new bootstrap.Modal(document.getElementById('editSaleModal'));
  modal.show();
    }

   // Add initial row when modal opens
        document.getElementById('addSaleModal').addEventListener('shown.bs.modal', function () {
      if (document.querySelectorAll('#saleDetailsBody tr').length === 0) {
       addSaleDetailRow();
        }
        });

      // Reset form when modal closes
        document.getElementById('addSaleModal').addEventListener('hidden.bs.modal', function () {
      document.getElementById('saleDetailsBody').innerHTML = '';
         rowIndex = 0;
     updateTotals();
        });

        document.getElementById('editSaleModal').addEventListener('hidden.bs.modal', function () {
  document.getElementById('editSaleDetailsBody').innerHTML = '';
     editRowIndex = 0;
   updateEditTotals();
        });

    // When sale date changes, refresh unit prices for rows
        document.querySelector('input[name="SaleDate"]').addEventListener('change', async function () {
          const saleDate = this.value;
       const rows = document.querySelectorAll('#saleDetailsBody tr');
    for (const row of rows) {
        const genderSelect = row.querySelector('select[name$=".Gender"]');
          if (!genderSelect) continue;
        const gender = genderSelect.value;

       let unitPrice = getPreloadedPrice(gender);
          if (!unitPrice) {
        const priceDto = await fetchActivePrice(livestockId, gender, saleDate);
         unitPrice = priceDto?.unitPrice ?? priceDto?.UnitPrice ?? 0;
        }

    if (row.querySelector('.price-input')) {
      row.querySelector('.price-input').value = unitPrice;
     updateRowAmount(row.querySelector('.price-input'));
    }
        }
      updateTotals();
        });

     function addSaleDetailRow() {
     const tbody = document.getElementById('saleDetailsBody');
 const row = document.createElement('tr');
 row.innerHTML = `
                <td class="text-center">${rowIndex + 1}</td>
       <td>
       <select name="Details[${rowIndex}].Gender" class="form-select form-select-sm gender-select" required>
             <option value="1">Đực</option>
    <option value="2">Cái</option>
     <option value="3">Hỗn hợp</option>
   </select>
</td>
                <td>
        <input type="number" name="Details[${rowIndex}].Quantity" class="form-control form-control-sm" value="0" min="0" onchange="updateTotals()" />
      </td>
        <td>
      <input type="number" name="Details[${rowIndex}].Weight" class="form-control form-control-sm weight-input" step="0.01" value="0" min="0" required onchange="updateRowAmount(this); updateTotals()" />
  </td>
        <td>
        <input type="number" name="Details[${rowIndex}].UnitPrice" class="form-control form-control-sm price-input" value="0" min="0" required onchange="updateRowAmount(this); updateTotals()" />
    </td>
         <td class="row-amount fw-bold text-success">0 đ</td>
         <td>
         <input type="text" name="Details[${rowIndex}].Note" class="form-control form-control-sm" placeholder="Ghi chú..." />
</td>
<td>
        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)" ${rowIndex === 0 ? 'disabled' : ''}>
 <i class="bi bi-trash"></i>
       </button>
    </td>
     `;
     tbody.appendChild(row);

     const genderSelect = row.querySelector('.gender-select');
 const priceInput = row.querySelector('.price-input');

 // Wire up gender change to auto-fill price
   genderSelect.addEventListener('change', async function () {
       const gender = this.value;
         const saleDateInput = document.querySelector('input[name="SaleDate"]');

  let unitPrice = getPreloadedPrice(gender);

           if (!unitPrice) {
  const priceDto = await fetchActivePrice(livestockId, gender, saleDateInput.value);
               unitPrice = priceDto?.unitPrice ?? priceDto?.UnitPrice ?? 0;
       }

     if (priceInput) {
        priceInput.value = unitPrice;
           updateRowAmount(priceInput);
      updateTotals();
        }
 });

       // Trigger initial auto-fill for the newly added row
            const initialGender = genderSelect.value;
   let initialPrice = getPreloadedPrice(initialGender);
        if (initialPrice && priceInput) {
     priceInput.value = initialPrice;
 updateRowAmount(priceInput);
            } else {
    (async () => {
     const saleDateInput = document.querySelector('input[name="SaleDate"]');
                  const priceDto = await fetchActivePrice(livestockId, initialGender, saleDateInput.value);
    if (priceDto && priceInput) {
         priceInput.value = priceDto.unitPrice ?? priceDto.UnitPrice ?? 0;
       updateRowAmount(priceInput);
   }
       updateTotals();
 })();
     }

            rowIndex++;
 updateRowNumbers();
     updateTotals();
        }

        function addEditSaleDetailRow(detail = null) {
            const tbody = document.getElementById('editSaleDetailsBody');
      const row = document.createElement('tr');
  
            const detailId = detail?.id || 0;
            const gender = detail?.gender || 1;
  const quantity = detail?.quantity || 0;
         const weight = detail?.weight || 0;
  const unitPrice = detail?.unitPrice || 0;
 const note = detail?.note || '';
            const amount = weight * unitPrice;

            row.innerHTML = `
     <td class="text-center">${editRowIndex + 1}</td>
       <td>
                  <input type="hidden" name="Details[${editRowIndex}].Id" value="${detailId}" />
                    <select name="Details[${editRowIndex}].Gender" class="form-select form-select-sm edit-gender-select" required>
               <option value="1" ${gender == 1 ? 'selected' : ''}>Đực</option>
     <option value="2" ${gender == 2 ? 'selected' : ''}>Cái</option>
          <option value="3" ${gender == 3 ? 'selected' : ''}>Hỗn hợp</option>
                 </select>
    </td>
     <td>
        <input type="number" name="Details[${editRowIndex}].Quantity" class="form-control form-control-sm" value="${quantity}" min="0" onchange="updateEditTotals()" />
       </td>
   <td>
         <input type="number" name="Details[${editRowIndex}].Weight" class="form-control form-control-sm edit-weight-input" step="0.01" value="${weight}" min="0" required onchange="updateEditRowAmount(this); updateEditTotals()" />
       </td>
  <td>
               <input type="number" name="Details[${editRowIndex}].UnitPrice" class="form-control form-control-sm edit-price-input" value="${unitPrice}" min="0" required onchange="updateEditRowAmount(this); updateEditTotals()" />
         </td>
  <td class="edit-row-amount fw-bold text-success">${amount.toLocaleString('vi-VN')} đ</td>
           <td>
       <input type="text" name="Details[${editRowIndex}].Note" class="form-control form-control-sm" placeholder="Ghi chú..." value="${note}" />
   </td>
      <td>
    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEditRow(this)" ${editRowIndex === 0 ? 'disabled' : ''}>
          <i class="bi bi-trash"></i>
   </button>
     </td>
   `;
            tbody.appendChild(row);

         const genderSelect = row.querySelector('.edit-gender-select');
         const priceInput = row.querySelector('.edit-price-input');

     genderSelect.addEventListener('change', async function () {
          const gender = this.value;
  const saleDateInput = document.getElementById('editSaleDate');

                let unitPrice = getPreloadedPrice(gender);

            if (!unitPrice) {
         const priceDto = await fetchActivePrice(livestockId, gender, saleDateInput.value);
                    unitPrice = priceDto?.unitPrice ?? priceDto?.UnitPrice ?? 0;
                }

      if (priceInput) {
           priceInput.value = unitPrice;
             updateEditRowAmount(priceInput);
          updateEditTotals();
          }
            });

editRowIndex++;
            updateEditRowNumbers();
   updateEditTotals();
        }

        function removeRow(btn) {
      const row = btn.closest('tr');
         row.remove();
      updateRowNumbers();
            updateTotals();
        }

        function removeEditRow(btn) {
            const row = btn.closest('tr');
     row.remove();
          updateEditRowNumbers();
        updateEditTotals();
        }

      function updateRowNumbers() {
            const rows = document.querySelectorAll('#saleDetailsBody tr');
            rows.forEach((row, index) => {
  row.querySelector('td:first-child').textContent = index + 1;
        row.querySelectorAll('[name]').forEach(input => {
  const name = input.getAttribute('name');
        input.setAttribute('name', name.replace(/\[\d+\]/, `[${index}]`));
      });
            });
            rows.forEach((row, index) => {
                const deleteBtn = row.querySelector('button[onclick="removeRow(this)"]');
       if (deleteBtn) {
           deleteBtn.disabled = rows.length === 1;
        }
            });
        }

  function updateEditRowNumbers() {
   const rows = document.querySelectorAll('#editSaleDetailsBody tr');
            rows.forEach((row, index) => {
     row.querySelector('td:first-child').textContent = index + 1;
                row.querySelectorAll('[name]').forEach(input => {
           const name = input.getAttribute('name');
      input.setAttribute('name', name.replace(/\[\d+\]/, `[${index}]`));
  });
            });
            rows.forEach((row, index) => {
         const deleteBtn = row.querySelector('button[onclick="removeEditRow(this)"]');
         if (deleteBtn) {
     deleteBtn.disabled = rows.length === 1;
  }
      });
        }

        function updateRowAmount(input) {
  const row = input.closest('tr');
            const weight = parseFloat(row.querySelector('.weight-input').value) || 0;
      const price = parseFloat(row.querySelector('.price-input').value) || 0;
    const amount = weight * price;
        row.querySelector('.row-amount').textContent = amount.toLocaleString('vi-VN') + ' đ';
  }

        function updateEditRowAmount(input) {
            const row = input.closest('tr');
            const weight = parseFloat(row.querySelector('.edit-weight-input').value) || 0;
            const price = parseFloat(row.querySelector('.edit-price-input').value) || 0;
      const amount = weight * price;
row.querySelector('.edit-row-amount').textContent = amount.toLocaleString('vi-VN') + ' đ';
        }

      function updateTotals() {
         let totalQuantity = 0;
            let totalWeight = 0;
            let totalAmount = 0;

         document.querySelectorAll('#saleDetailsBody tr').forEach(row => {
         const quantity = parseInt(row.querySelector('[name$=".Quantity"]').value) || 0;
      const weight = parseFloat(row.querySelector('.weight-input').value) || 0;
         const price = parseFloat(row.querySelector('.price-input').value) || 0;

                totalQuantity += quantity;
   totalWeight += weight;
                totalAmount += weight * price;
            });

            document.getElementById('totalQuantity').textContent = totalQuantity + ' con';
     document.getElementById('totalWeight').textContent = totalWeight.toFixed(2) + ' kg';
  document.getElementById('totalAmount').textContent = totalAmount.toLocaleString('vi-VN') + ' đ';
        }

        function updateEditTotals() {
   let totalQuantity = 0;
            let totalWeight = 0;
            let totalAmount = 0;

        document.querySelectorAll('#editSaleDetailsBody tr').forEach(row => {
     const quantity = parseInt(row.querySelector('[name$=".Quantity"]').value) || 0;
     const weight = parseFloat(row.querySelector('.edit-weight-input').value) || 0;
    const price = parseFloat(row.querySelector('.edit-price-input').value) || 0;

              totalQuantity += quantity;
                totalWeight += weight;
       totalAmount += weight * price;
    });

 document.getElementById('editTotalQuantity').textContent = totalQuantity + ' con';
            document.getElementById('editTotalWeight').textContent = totalWeight.toFixed(2) + ' kg';
     document.getElementById('editTotalAmount').textContent = totalAmount.toLocaleString('vi-VN') + ' đ';
        }

        function viewSaleDetails(saleId) {
      const detailRow = document.getElementById('sale-detail-' + saleId);
            if (detailRow) {
        detailRow.classList.toggle('d-none');
      }
        }
    </script>
}
