@model FarmManagement.Application.DTOs.Livestocks.LivestockDto
@using FarmManagement.Application.DTOs.Livestocks
@using FarmManagement.Domain.Entities.Livestocks

@{
    ViewData["Title"] = $"Chi tiết vật nuôi - {Model.Name ?? Model.TagCode ?? $"VN-{Model.Id:D4}"}";
    ViewData["Breadcrumb"] = "Chi tiết";

    var careLogs = ViewBag.CareLogs as List<LivestockCareLogDto> ?? new List<LivestockCareLogDto>();
    var healthLogs = ViewBag.HealthLogs as List<LivestockHealthLogDto> ?? new List<LivestockHealthLogDto>();
    var sales = ViewBag.Sales as List<LivestockSaleDto> ?? new List<LivestockSaleDto>();
    var prices = ViewBag.Prices as List<LivestockPriceDto> ?? new List<LivestockPriceDto>();

    var careTypes = ViewBag.CareTypes as List<LivestockCareTypeDto> ?? new List<LivestockCareTypeDto>();
    var healthStatuses = ViewBag.HealthStatuses as List<LivestockHealthStatusDto> ?? new List<LivestockHealthStatusDto>();
    var saleTypes = ViewBag.SaleTypes as List<SaleTypeDto> ?? new List<SaleTypeDto>();

    // Lấy loại bán theo kg (SaleMethod = PerKilogram)
    var perKgSaleType = saleTypes.FirstOrDefault(x => x.SaleMethod == SaleMethod.PerKilogram);
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">@(Model.Name ?? Model.TagCode ?? $"VN-{Model.Id:D4}")</h1>
        <p class="page-subtitle mb-0">
            <span class="badge bg-info me-2">@Model.LivestockTypeName</span>
            <i class="bi bi-geo-alt"></i> @Model.LocationName
        </p>
    </div>
    <div class="page-actions d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@Model.Quantity</div>
                    <div class="stats-card-label">Số lượng (con)</div>
                    <small class="text-muted">
                        <i class="bi bi-gender-male text-primary"></i> @Model.MaleCount đực |
                        <i class="bi bi-gender-female text-danger"></i> @Model.FemaleCount cái
                    </small>
                </div>
                <div class="stats-card-icon primary">
                    <i class="bi bi-bug"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@Model.TotalImportWeight.ToString("N1")</div>
                    <div class="stats-card-label">Tổng trọng lượng (kg)</div>
                    <small class="text-muted">~@Model.ImportWeight.ToString("N1") kg/con</small>
                </div>
                <div class="stats-card-icon success">
                    <i class="bi bi-speedometer2"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@Model.TotalImportPrice.ToString("N0")</div>
                    <div class="stats-card-label">Tổng giá nhập (VNĐ)</div>
                    <small class="text-muted">~@Model.ImportPrice.ToString("N0")₫/con</small>
                </div>
                <div class="stats-card-icon warning">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@sales.Sum(s => s.TotalAmount).ToString("N0")</div>
                    <div class="stats-card-label">Doanh thu bán</div>
                    <small class="text-muted">@sales.Count đơn hàng</small>
                </div>
                <div class="stats-card-icon danger">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Basic Info Card -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-info-circle me-2"></i>Thông tin cơ bản
        </h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @if (!string.IsNullOrEmpty(Model.Name))
            {
                <div class="col-md-4">
                    <strong>Tên đàn:</strong>
                    <span class="ms-2 fw-medium">@Model.Name</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.TagCode))
            {
                <div class="col-md-4">
                    <strong>Mã thẻ/Mã lô:</strong>
                    <span class="ms-2"><code>@Model.TagCode</code></span>
                </div>
            }
            <div class="col-md-4">
                <strong>Loại vật nuôi:</strong>
                <span class="badge bg-info ms-2">@Model.LivestockTypeName</span>
            </div>
            <div class="col-md-4">
                <strong>Vị trí:</strong>
                <span class="ms-2"><i class="bi bi-geo-alt"></i> @Model.LocationName</span>
            </div>
            <div class="col-md-4">
                <strong>Trạng thái:</strong>
                @{
                    var statusClass = Model.LivestockStatusName switch
                    {
                        var s when s?.Contains("nuôi") == true => "badge-active",
                        var s when s?.Contains("Bán") == true => "bg-warning text-dark",
                        var s when s?.Contains("Chết") == true || s?.Contains("mổ") == true => "bg-danger",
                        _ => "badge-inactive"
                    };
                }
                <span class="badge badge-status @statusClass ms-2">@Model.LivestockStatusName</span>
            </div>
            <div class="col-md-4">
                <strong>Số lượng:</strong>
                <span class="ms-2 fw-medium">@Model.QuantityDisplay</span>
            </div>
            <div class="col-md-4">
                <strong>Ngày nhập:</strong>
                <span class="ms-2">@Model.ImportDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="col-md-4">
                <strong>Ngày tạo:</strong>
                <span class="ms-2">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            @if (Model.UpdatedDate.HasValue)
            {
                <div class="col-md-4">
                    <strong>Cập nhật:</strong>
                    <span class="ms-2">@Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="col-12">
                    <strong>Ghi chú:</strong>
                    <p class="mb-0 mt-1 text-muted">@Model.Note</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="livestockTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="care-tab" data-bs-toggle="tab" data-bs-target="#care" type="button" role="tab">
            <i class="bi bi-heart me-1"></i> Chăm sóc (@careLogs.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="health-tab" data-bs-toggle="tab" data-bs-target="#health" type="button" role="tab">
            <i class="bi bi-activity me-1"></i> Sức khỏe (@healthLogs.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button" role="tab">
            <i class="bi bi-cash me-1"></i> Bán hàng (@sales.Count đơn)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="prices-tab" data-bs-toggle="tab" data-bs-target="#prices" type="button" role="tab">
            <i class="bi bi-tags me-1"></i> Giá (@prices.Count)
        </button>
    </li>
</ul>

<div class="tab-content" id="livestockTabsContent">
    <!-- Care Logs Tab -->
    <div class="tab-pane fade show active" id="care" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Nhật ký chăm sóc</h6>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addCareLogModal">
                    <i class="bi bi-plus-lg me-1"></i> Thêm
                </button>
            </div>
            <div class="card-body p-0">
                @if (careLogs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Ngày</th>
                                    <th>Loại chăm sóc</th>
                                    <th>Số lượng</th>
                                    <th>Chi phí</th>
                                    <th>Ghi chú</th>
                                    <th width="80"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in careLogs)
                                {
                                    <tr>
                                        <td>@log.CareDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-info">@log.LivestockCareTypeName</span></td>
                                        <td>@log.Quantity @log.Unit</td>
                                        <td class="text-success fw-medium">@log.Cost.ToString("N0") đ</td>
                                        <td class="text-muted">@log.Note</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                                onclick="openEditCareLogModal(@log.Id, @log.LivestockCareTypeId, '@log.CareDate.ToString("yyyy-MM-dd")', @log.Quantity, '@(log.Unit ?? "")', @log.Cost, '@(log.Note ?? "")')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="DeleteCareLog" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@log.Id" />
                                                <input type="hidden" name="livestockId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa nhật ký này?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-heart fs-1 d-block mb-2"></i>
                        Chưa có nhật ký chăm sóc
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Health Logs Tab -->
    <div class="tab-pane fade" id="health" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Nhật ký sức khỏe</h6>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addHealthLogModal">
                    <i class="bi bi-plus-lg me-1"></i> Thêm
                </button>
            </div>
            <div class="card-body p-0">
                @if (healthLogs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Ngày kiểm tra</th>
                                    <th>Trạng thái</th>
                                    <th>Triệu chứng</th>
                                    <th>Điều trị</th>
                                    <th>Chi phí thuốc</th>
                                    <th>Bác sĩ</th>
                                    <th width="80"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in healthLogs)
                                {
                                    <tr>
                                        <td>@log.CheckDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-warning text-dark">@log.HealthStatusName</span></td>
                                        <td>@log.Symptom</td>
                                        <td>@log.Treatment</td>
                                        <td class="text-danger fw-medium">@log.MedicineCost.ToString("N0") đ</td>
                                        <td>@log.VetName</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                                onclick="openEditHealthLogModal(@log.Id, @log.HealthStatusId, '@log.CheckDate.ToString("yyyy-MM-dd")', '@(log.Symptom ?? "")', '@(log.Treatment ?? "")', @log.MedicineCost, '@(log.VetName ?? "")')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="DeleteHealthLog" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@log.Id" />
                                                <input type="hidden" name="livestockId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa nhật ký này?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-activity fs-1 d-block mb-2"></i>
                        Chưa có nhật ký sức khỏe
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sales Tab -->
    <div class="tab-pane fade" id="sales" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Đơn hàng bán (Theo kg)</h6>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addSaleModal">
                    <i class="bi bi-plus-lg me-1"></i> Tạo đơn hàng
                </button>
            </div>
            <div class="card-body p-0">
                @if (sales.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Ngày bán</th>
                                    <th>Số dòng</th>
                                    <th>Tổng kg</th>
                                    <th>Tổng con</th>
                                    <th>Tổng tiền</th>
                                    <th>Người mua</th>
                                    <th width="100"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in sales)
                                {
                                    <tr>
                                        <td><code>@sale.OrderCode</code></td>
                                        <td>@sale.SaleDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-info">@sale.DetailCount dòng</span></td>
                                        <td class="fw-medium">@sale.TotalWeight.ToString("N2") kg</td>
                                        <td>@sale.TotalQuantity con</td>
                                        <td class="text-success fw-bold">@sale.TotalAmount.ToString("N0") đ</td>
                                        <td>@sale.Buyer</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-info" title="Xem chi tiết" onclick="viewSaleDetails(@sale.Id)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary" title="Sửa đơn hàng" 
         onclick="openEditSaleModal(@sale.Id, '@sale.SaleDate.ToString("yyyy-MM-dd")', '@(sale.Buyer ?? "")', '@(sale.BuyerPhone ?? "")', '@(sale.Note ?? "")')">
        <i class="bi bi-pencil"></i>
              </button>
                                                <form asp-action="DeleteSale" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@sale.Id" />
                                                    <input type="hidden" name="livestockId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Xóa đơn hàng này?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <!-- Expandable detail row -->
                                    <tr class="sale-detail-row d-none" id="sale-detail-@sale.Id">
                                        <td colspan="8" class="bg-light p-3">
                                            <strong class="d-block mb-2">Chi tiết đơn hàng @sale.OrderCode:</strong>
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-secondary">
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Giới tính</th>
                                                        <th>Số con</th>
                                                        <th>Trọng lượng</th>
                                                        <th>Đơn giá</th>
                                                        <th>Thành tiền</th>
                                                        <th>Ghi chú</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var detail in sale.Details)
                                                    {
                                                        <tr>
                                                            <td>@detail.LineNumber</td>
                                                            <td>
                                                                @if (detail.Gender == GenderType.Male)
                                                                {
                                                                    <span class="badge bg-primary">Đực</span>
                                                                }
                                                                else if (detail.Gender == GenderType.Female)
                                                                {
                                                                    <span class="badge bg-danger">Cái</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary">Hỗn hợp</span>
                                                                }
                                                            </td>
                                                            <td>@detail.Quantity con</td>
                                                            <td>@detail.Weight.ToString("N2") kg</td>
                                                            <td>@detail.UnitPrice.ToString("N0") đ/kg</td>
                                                            <td class="fw-bold text-success">@detail.Amount.ToString("N0") đ</td>
                                                            <td class="text-muted">@detail.Note</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-cash fs-1 d-block mb-2"></i>
                        Chưa có đơn hàng bán
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Prices Tab -->
    <div class="tab-pane fade" id="prices" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Bảng giá</h6>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addPriceModal">
                    <i class="bi bi-plus-lg me-1"></i> Thêm
                </button>
            </div>
            <div class="card-body p-0">
                @if (prices.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Giới tính</th>
                                    <th>Đơn giá (đ/kg)</th>
                                    <th>Ngày bắt đầu</th>
                                    <th>Ngày kết thúc</th>
                                    <th>Trạng thái</th>
                                    <th>Ghi chú</th>
                                    <th width="100"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var price in prices)
                                {
                                    <tr>
                                        <td>
                                            @if (price.Gender == GenderType.Male)
                                            {
                                                <span class="badge bg-primary">Đực</span>
                                            }
                                            else if (price.Gender == GenderType.Female)
                                            {
                                                <span class="badge bg-danger">Cái</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Hỗn hợp</span>
                                            }
                                        </td>
                                        <td class="text-success fw-medium">@price.UnitPrice.ToString("N0") đ</td>
                                        <td>@price.EffectiveFrom.ToString("dd/MM/yyyy")</td>
                                        <td>@(price.EffectiveTo.HasValue? price.EffectiveTo.Value.ToString("dd/MM/yyyy") : "Vô thời hạn")</td>
                                        <td>
                                            @if (price.IsActive)
                                            {
                                                <span class="badge bg-success">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Không hoạt động</span>
                                            }
                                        </td>
                                        <td class="text-muted">@price.Note</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                                    onclick="openEditPriceModal(@price.Id, @((int)price.Gender), @price.UnitPrice, '@price.EffectiveFrom.ToString("yyyy-MM-dd")', '@(price.EffectiveTo?.ToString("yyyy-MM-dd") ?? "")', @price.IsActive.ToString().ToLower(), '@(price.Note ?? "")')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="DeletePrice" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@price.Id" />
                                                <input type="hidden" name="livestockId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa giá này?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-tags fs-1 d-block mb-2"></i>
                        Chưa có cấu hình giá
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add Care Log Modal -->
<div class="modal fade" id="addCareLogModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateCareLog" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="LivestockId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Thêm nhật ký chăm sóc</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Loại chăm sóc <span class="text-danger">*</span></label>
                        <select name="LivestockCareTypeId" class="form-select" required>
