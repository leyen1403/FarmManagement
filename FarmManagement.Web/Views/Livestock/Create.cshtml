@model FarmManagement.Application.DTOs.Livestocks.CreateLivestockDto
@using FarmManagement.Application.DTOs.Livestocks
@using FarmManagement.Application.DTOs.Locations

@{
    ViewData["Title"] = "Thêm vật nuôi";
    ViewData["Breadcrumb"] = "Thêm mới";

    var livestockTypes = ViewBag.LivestockTypes as List<LivestockTypeDto> ?? new List<LivestockTypeDto>();
    var livestockStatuses = ViewBag.LivestockStatuses as List<LivestockStatusDto> ?? new List<LivestockStatusDto>();
    var locations = ViewBag.Locations as List<LocationDto> ?? new List<LocationDto>();
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Thêm vật nuôi mới</h1>
        <p class="page-subtitle mb-0">Nhập thông tin vật nuôi/đàn vật nuôi cần thêm</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-bug me-2"></i>Thông tin vật nuôi
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- Thông tin cơ bản -->
            <h6 class="text-muted mb-3"><i class="bi bi-info-circle me-2"></i>Thông tin cơ bản</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Tên đàn/Mô tả</label>
                    <input asp-for="Name" class="form-control" placeholder="VD: Đàn heo giống lứa 1, Gà đẻ chuồng A..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <small class="form-text text-muted">Đặt tên để dễ nhận biết đàn vật nuôi</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="TagCode" class="form-label">Mã thẻ/Mã lô</label>
                    <input asp-for="TagCode" class="form-control" placeholder="VD: HEO-2024-001" />
                    <span asp-validation-for="TagCode" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LivestockTypeId" class="form-label">Loại vật nuôi <span class="text-danger">*</span></label>
                    <select asp-for="LivestockTypeId" class="form-select" asp-items="@(new SelectList(livestockTypes, "Id", "Name"))">
                        <option value="">-- Chọn loại vật nuôi --</option>
                    </select>
                    <span asp-validation-for="LivestockTypeId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LivestockStatusId" class="form-label">Trạng thái <span class="text-danger">*</span></label>
                    <select asp-for="LivestockStatusId" class="form-select" asp-items="@(new SelectList(livestockStatuses, "Id", "Name"))">
                        <option value="">-- Chọn trạng thái --</option>
                    </select>
                    <span asp-validation-for="LivestockStatusId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LocationId" class="form-label">Vị trí nuôi <span class="text-danger">*</span></label>
                    <select asp-for="LocationId" class="form-select" asp-items="@(new SelectList(locations, "Id", "Name"))">
                        <option value="">-- Chọn vị trí --</option>
                    </select>
                    <span asp-validation-for="LocationId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImportDate" class="form-label">Ngày nhập <span class="text-danger">*</span></label>
                    <input asp-for="ImportDate" type="date" class="form-control" />
                    <span asp-validation-for="ImportDate" class="text-danger"></span>
                </div>
            </div>

            <!-- Số lượng -->
            <h6 class="text-muted mb-3"><i class="bi bi-123 me-2"></i>Số lượng</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Quantity" class="form-label">Tổng số lượng (con) <span class="text-danger">*</span></label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" id="quantityInput" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MaleCount" class="form-label">
                        <i class="bi bi-gender-male text-primary me-1"></i>Số con đực
                    </label>
                    <input asp-for="MaleCount" type="number" min="0" class="form-control" id="maleInput" />
                    <span asp-validation-for="MaleCount" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FemaleCount" class="form-label">
                        <i class="bi bi-gender-female text-danger me-1"></i>Số con cái
                    </label>
                    <input asp-for="FemaleCount" type="number" min="0" class="form-control" id="femaleInput" />
                    <span asp-validation-for="FemaleCount" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="alert alert-info py-2" id="genderValidation" style="display: none;">
                        <i class="bi bi-info-circle me-2"></i>
                        <span id="genderMessage"></span>
                    </div>
                </div>
            </div>

            <!-- Trọng lượng và Giá -->
            <h6 class="text-muted mb-3"><i class="bi bi-currency-dollar me-2"></i>Trọng lượng & Giá trị</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="ImportWeight" class="form-label">Trọng lượng TB/con (kg)</label>
                    <input asp-for="ImportWeight" type="number" step="0.1" min="0" class="form-control" id="weightInput" placeholder="0.0" />
                    <span asp-validation-for="ImportWeight" class="text-danger"></span>
                    <small class="form-text text-muted">Tổng TL: <strong id="totalWeight">0</strong> kg</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImportPrice" class="form-label">Giá nhập/con (VNĐ)</label>
                    <input asp-for="ImportPrice" type="number" step="1000" min="0" class="form-control" id="priceInput" placeholder="0" />
                    <span asp-validation-for="ImportPrice" class="text-danger"></span>
                    <small class="form-text text-muted">Tổng giá trị: <strong id="totalPrice">0</strong> VNĐ</small>
                </div>
            </div>

            <!-- Ghi chú -->
            <h6 class="text-muted mb-3"><i class="bi bi-sticky me-2"></i>Ghi chú</h6>
            <div class="row g-3">
                <div class="col-12">
                    <textarea asp-for="Note" class="form-control" rows="3" placeholder="Nhập ghi chú về nguồn gốc, đặc điểm... (tùy chọn)"></textarea>
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-lg me-1"></i>Hủy
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Lưu vật nuôi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
               const quantityInput = document.getElementById('quantityInput');
         const maleInput = document.getElementById('maleInput');
         const femaleInput = document.getElementById('femaleInput');
         const weightInput = document.getElementById('weightInput');
        const priceInput = document.getElementById('priceInput');
               const genderValidation = document.getElementById('genderValidation');
               const genderMessage = document.getElementById('genderMessage');
               const totalWeight = document.getElementById('totalWeight');
            const totalPrice = document.getElementById('totalPrice');

               function validateGender() {
          const quantity = parseInt(quantityInput.value) || 0;
        const male = parseInt(maleInput.value) || 0;
            const female = parseInt(femaleInput.value) || 0;
          const total = male + female;

               if (total > quantity) {
           genderValidation.style.display = 'block';
                 genderValidation.className = 'alert alert-danger py-2';
          genderMessage.textContent = `Tổng đực (${male}) + cái (${female}) = ${total} vượt quá số lượng (${quantity})!`;
             } else if (total < quantity && total > 0) {
             genderValidation.style.display = 'block';
           genderValidation.className = 'alert alert-warning py-2';
         genderMessage.textContent = `Còn ${quantity - total} con chưa xác định giới tính.`;
        } else if (total === quantity && quantity > 0) {
             genderValidation.style.display = 'block';
              genderValidation.className = 'alert alert-success py-2';
             genderMessage.textContent = `Đã xác định đủ giới tính: ${male} đực + ${female} cái = ${quantity} con.`;
            } else {
                   genderValidation.style.display = 'none';
             }
         }

               function calculateTotals() {
                   const quantity = parseInt(quantityInput.value) || 0;
           const weight = parseFloat(weightInput.value) || 0;
           const price = parseFloat(priceInput.value) || 0;

            totalWeight.textContent = (quantity * weight).toLocaleString('vi-VN', {maximumFractionDigits: 1});
                 totalPrice.textContent = (quantity * price).toLocaleString('vi-VN');
               }

               quantityInput.addEventListener('input', function() { validateGender(); calculateTotals(); });
               maleInput.addEventListener('input', validateGender);
               femaleInput.addEventListener('input', validateGender);
               weightInput.addEventListener('input', calculateTotals);
               priceInput.addEventListener('input', calculateTotals);

             // Initialize
           validateGender();
               calculateTotals();
    </script>
}
