@*
    _StatsCards.cshtml
  Partial view để render nhiều thẻ thống kê trong một grid
    Sử dụng: @await Html.PartialAsync("_StatsCards", listOfStats)
  Hoặc: <partial name="_StatsCards" model="listOfStats" />
*@

@model IEnumerable<StatsCardModel>

@{
    var statsList = Model?.ToList() ?? new List<StatsCardModel>();
  
    // Tính toán số cột dựa trên số lượng cards
    var colClass = statsList.Count switch
    {
  1 => "col-12",
        2 => "col-md-6",
        3 => "col-md-6 col-lg-4",
        4 => "col-md-6 col-xl-3",
  _ => "col-md-6 col-xl-3"
    };
}

@if (statsList.Count > 0)
{
    <div class="stats-cards-container mb-4">
        <div class="row g-3">
@foreach (var stat in statsList)
     {
   <div class="@colClass">
@await Html.PartialAsync("_StatsCard", stat)
      </div>
        }
        </div>
    </div>
}
