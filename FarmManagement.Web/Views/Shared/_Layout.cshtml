<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Farm Management</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <i class="bi bi-tree"></i>
                </div>
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand-text">
                    FarmMgmt
                </a>
            </div>

            <nav class="sidebar-nav">
                <!-- Dashboard -->
                <a asp-controller="Home" asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>

                <!-- Locations Section -->
                <div class="nav-section">
                    <div class="nav-section-title">Quản lý vị trí</div>
                </div>

                <a asp-controller="Location" asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Location" ? "active" : "")">
                    <i class="bi bi-geo-alt"></i>
                    <span>Vị trí</span>
                </a>

                <a asp-controller="LocationTypes" asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LocationTypes" ? "active" : "")">
                    <i class="bi bi-tags"></i>
                    <span>Loại vị trí</span>
                </a>

                <a asp-controller="LocationStatuses" asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LocationStatuses" ? "active" : "")">
                    <i class="bi bi-toggle-on"></i>
                    <span>Trạng thái vị trí</span>
                </a>

                <!-- Crops Section -->
                <div class="nav-section">
                    <div class="nav-section-title">Quản lý cây trồng</div>
                </div>

                <a asp-controller="Crop" asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Crop" ? "active" : "")">
                  <i class="bi bi-flower2"></i>
                    <span>Cây trồng</span>
                </a>

                <a asp-controller="CropType" asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CropType" ? "active" : "")">
                    <i class="bi bi-flower1"></i>
                    <span>Loại cây trồng</span>
                </a>

                <a asp-controller="CropStatus" asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CropStatus" ? "active" : "")">
                    <i class="bi bi-heart-pulse"></i>
                    <span>Trạng thái cây trồng</span>
                </a>

                <!-- Settings Section -->
                <div class="nav-section">
                    <div class="nav-section-title">Hệ thống</div>
                </div>

                <a asp-controller="Home" asp-action="Privacy" class="nav-link">
                    <i class="bi bi-shield-lock"></i>
                    <span>Chính sách</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <header class="main-header">
                <div class="d-flex align-items-center gap-3">
                    <button class="sidebar-toggle" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house"></i>
                                </a>
                            </li>
                            @if (ViewData["Breadcrumb"] != null)
                            {
                                <li class="breadcrumb-item active">@ViewData["Breadcrumb"]</li>
                            }
                        </ol>
                    </nav>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i> Admin
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Body -->
            <main class="main-body">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="main-footer">
                &copy; @DateTime.Now.Year Farm Management System. All rights reserved.
            </footer>
        </div>
    </div>

    <!-- Overlay for mobile sidebar -->
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
