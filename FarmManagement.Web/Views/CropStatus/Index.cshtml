@model IEnumerable<FarmManagement.Application.DTOs.Crops.CropStatusDto>

@{
    ViewData["Title"] = "Trạng thái cây trồng";
    ViewData["Breadcrumb"] = "Trạng thái cây trồng";
}

@* ==================== Page Header ==================== *@
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Trạng thái cây trồng</h1>
        <p class="page-subtitle mb-0 text-muted">Quản lý các trạng thái của cây trồng trong hệ thống</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm mới
        </a>
    </div>
</div>

@* ==================== Notifications ==================== *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ==================== Main Table Container ==================== *@
<div class="table-container shadow-sm rounded bg-white">
    <div class="table-toolbar p-3 border-bottom d-flex justify-content-between align-items-center bg-light bg-opacity-50">
        <div class="table-search position-relative">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <input type="text" class="form-control ps-5" id="searchInput" placeholder="Tìm kiếm trạng thái...">
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-secondary px-3 py-2">Tổng: @Model.Count()</span>
            <span class="badge badge-active px-3 py-2 bg-success">Hoạt động: @Model.Count(x => x.IsActive)</span>
            <span class="badge badge-inactive px-3 py-2 bg-danger">Tắt: @Model.Count(x => !x.IsActive)</span>
        </div>
    </div>

    @if (Model.Any())
    {
        <table class="table data-table mb-0 align-middle" id="dataTable">
            <thead class="table-light">
                <tr>
                    <th width="60" class="ps-3">#</th>
                    <th>Mã</th>
                    <th>Tên trạng thái</th>
                    <th>Mô tả</th>
                    <th width="150" class="text-center">Trạng thái</th>
                    <th width="140" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted ps-3">@item.Id</td>
                        <td>
                            <code class="bg-light px-2 py-1 rounded text-primary">@item.Code</code>
                        </td>
                        <td class="fw-medium">@item.Name</td>
                        <td class="text-muted small">@(item.Description ?? "-")</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3">
                                    <i class="bi bi-check-circle me-1"></i>Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3">
                                    <i class="bi bi-x-circle me-1"></i>Tắt
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="action-buttons d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="Xóa"
                                        onclick="confirmDelete(@item.Id, '@item.Name')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state py-5 text-center">
            <div class="empty-state-icon mb-3">
                <i class="bi bi-inbox text-muted display-4"></i>
            </div>
            <h5 class="empty-state-title">Chưa có dữ liệu trạng thái</h5>
            <p class="text-muted">Bắt đầu bằng cách thêm trạng thái cây trồng đầu tiên vào hệ thống.</p>
            <a asp-action="Create" class="btn btn-primary px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i> Thêm mới ngay
            </a>
        </div>
    }
</div>

@* ==================== Modals ==================== *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p>Bạn có chắc chắn muốn xóa trạng thái <strong id="deleteItemName" class="text-danger"></strong>?</p>
                <p class="text-muted small mb-0">Lưu ý: Hành động này không thể hoàn tác và có thể ảnh hưởng đến dữ liệu cây trồng liên quan.</p>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                <a id="deleteLink" href="#" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i>Xác nhận xóa
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Xử lý tìm kiếm thời gian thực
        document.getElementById('searchInput').addEventListener('keyup', function () {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('#dataTable tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });

        // Xử lý xác nhận xóa
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            // Lưu ý: Url.Action sẽ tạo URL tại server-side
            document.getElementById('deleteLink').href = '@Url.Action("Delete")/' + id;

            const modalElement = document.getElementById('deleteModal');
            const deleteModal = new bootstrap.Modal(modalElement);
            deleteModal.show();
        }
    </script>
}