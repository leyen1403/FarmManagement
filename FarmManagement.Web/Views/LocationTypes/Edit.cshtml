@model FarmManagement.Application.DTOs.Locations.LocationTypeDto

@{
    ViewData["Title"] = "Sửa loại vị trí";
    ViewData["Breadcrumb"] = "Sửa loại vị trí";
}

<div class="page-header mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="LocationTypes" asp-action="Index">Loại vị trí</a>
            </li>
            <li class="breadcrumb-item active">Sửa</li>
        </ol>
    </nav>
    <h1 class="page-title">Sửa loại vị trí</h1>
    <p class="page-subtitle">Cập nhật thông tin loại vị trí #@Model.Id</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-pencil me-2"></i>Thông tin loại vị trí
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label">
                                <i class="bi bi-hash me-1"></i>Mã loại
                            </label>
                            <input asp-for="Code" class="form-control bg-light" readonly />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                            <div class="form-text">Mã không thể thay đổi</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-tag me-1"></i>Tên loại <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-info-circle me-2"></i>Thông tin
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">ID</small>
                    <strong>@Model.Id</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Mã</small>
                    <code class="bg-light px-2 py-1 rounded">@Model.Code</code>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày tạo</small>
                    <strong>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                <div>
                    <small class="text-muted d-block">Cập nhật lần cuối</small>
                    <strong>@Model.UpdatedDate.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>
        </div>

        <!-- Danger Zone -->
        <div class="card border-danger mt-3">
            <div class="card-header bg-danger bg-opacity-10 border-danger">
                <h5 class="card-title mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>Vùng nguy hiểm
                </h5>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">Các thao tác không thể hoàn tác</p>
                <a asp-action="Delete" asp-route-id="@Model.Id"
                   class="btn btn-outline-danger btn-sm w-100"
                   onclick="return confirm('Bạn có chắc chắn muốn xóa loại vị trí này?');">
                    <i class="bi bi-trash me-1"></i>Xóa loại vị trí này
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}