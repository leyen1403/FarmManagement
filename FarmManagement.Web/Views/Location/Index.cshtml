@using FarmManagement.Application.DTOs.Locations
@model IEnumerable<LocationDto>

@{
    ViewData["Title"] = "Quản lý vị trí";

    // Breadcrumbs
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        BreadcrumbItem.Current("Vị trí", "bi bi-geo-alt")
    );

    // Get filter values from query string
    var searchTerm = Context.Request.Query["searchTerm"].ToString();
    var typeFilter = Context.Request.Query["typeId"].ToString();
    var statusFilter = Context.Request.Query["statusId"].ToString();

    var types = ViewBag.Types as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var statuses = ViewBag.Statuses as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    var totalCount = Model.Count();
    var activeCount = Model.Count(x =>
        x.LocationStatusName?.ToLower().Contains("hoạt động") == true ||
        x.LocationStatusName?.ToLower().Contains("active") == true
    );

    // Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = "Quản lý vị trí",
        Subtitle = "Quản lý các vị trí, khu vực trong nông trại",
        Icon = "bi bi-geo-alt",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            new ActionButtonModel("Xuất Excel", "#", "bi bi-file-earmark-excel", "btn-outline-success")
            {
                Size = ButtonSize.Small
            },
            ActionButtonModel.Create("/Location/Create", "Thêm vị trí")
        }
    };

    // Stats Cards
    var statsCards = new List<StatsCardModel>
    {
        new StatsCardModel
        {
            Value = totalCount.ToString(),
            Label = "Tổng vị trí",
            Icon = "bi bi-geo-alt",
            IconBackgroundClass = "bg-primary-subtle",
            ColorClass = "text-primary"
        },
        new StatsCardModel
        {
            Value = activeCount.ToString(),
            Label = "Đang hoạt động",
            Icon = "bi bi-check-circle",
            IconBackgroundClass = "bg-success-subtle",
            ColorClass = "text-success"
        },
        new StatsCardModel
        {
            Value = (totalCount - activeCount).ToString(),
            Label = "Không hoạt động",
            Icon = "bi bi-pause-circle",
            IconBackgroundClass = "bg-secondary-subtle",
            ColorClass = "text-secondary"
        },
        new StatsCardModel
        {
            Value = types.Count().ToString(),
            Label = "Loại vị trí",
            Icon = "bi bi-tags",
            IconBackgroundClass = "bg-info-subtle",
            ColorClass = "text-info",
            LinkUrl = "/LocationTypes",
            LinkText = "Quản lý"
        }
    };

    // Filter Form
    var filterForm = new FilterFormModel
    {
        ActionUrl = "/Location",
        Method = "GET",
        Title = "Bộ lọc tìm kiếm",
        Icon = "bi bi-funnel",
        IsExpanded =
            !string.IsNullOrEmpty(searchTerm) ||
            !string.IsNullOrEmpty(typeFilter) ||
            !string.IsNullOrEmpty(statusFilter),
        ResetUrl = "/Location",
        ColumnsPerRow = 3,
        Fields = new List<FilterFieldModel>
        {
            new FilterFieldModel
            {
                Name = "searchTerm",
                Label = "Tìm kiếm",
                Type = FilterFieldType.Text,
                Value = searchTerm,
                Placeholder = "Tên vị trí, địa chỉ...",
                Icon = "bi bi-search",
                ColSpan = 4
            },
            new FilterFieldModel
            {
                Name = "typeId",
                Label = "Loại vị trí",
                Type = FilterFieldType.Select,
                Value = typeFilter,
                Placeholder = "Tất cả loại",
                ColSpan = 4,
                Options = types.Select(t =>
                    new SelectOptionModel(
                        t.Id.ToString(),
                        t.Name,
                        t.Id.ToString() == typeFilter
                    )
                ).ToList()
            },
            new FilterFieldModel
            {
                Name = "statusId",
                Label = "Trạng thái",
                Type = FilterFieldType.Select,
                Value = statusFilter,
                Placeholder = "Tất cả trạng thái",
                ColSpan = 4,
                Options = statuses.Select(s =>
                    new SelectOptionModel(
                        s.Id.ToString(),
                        s.Name,
                        s.Id.ToString() == statusFilter
                    )
                ).ToList()
            }
        }
    };

    // Table Container
    var tableContainer = new TableContainerModel
    {
        Title = "Danh sách vị trí",
        Icon = "bi bi-list-ul",
        ShowQuickSearch = true,
        QuickSearchPlaceholder = "Tìm nhanh...",
        SearchValue = searchTerm,
        TotalRecords = totalCount,
        TotalBadgeText = "vị trí",
        HasData = Model.Any(),
        TableId = "locationTable",
        EmptyState = EmptyStateModel.NoData("vị trí", "/Location/Create")
    };

    // Delete Modal
    var deleteModal = DeleteModalModel.ForEntity("vị trí", "Location");
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

@* ==================== Stats Cards ==================== *@
<partial name="_StatsCards" model="statsCards" />

@* ==================== Filter Form ==================== *@
<partial name="_FilterForm" model="filterForm" />

@* ==================== Data Table ==================== *@
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <div class="d-flex align-items-center gap-2">
            <h6 class="card-title mb-0 fw-semibold">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Danh sách vị trí
            </h6>
            <span class="badge bg-primary">@totalCount</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 250px;">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text"
                       class="form-control"
                       id="quickSearch"
                       placeholder="Tìm nhanh trong bảng..." />
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="locationTable">
                <thead class="bg-light">
                    <tr>
                        <th width="60" class="text-center">#</th>
                        <th>Tên vị trí</th>
                        <th width="150">Loại</th>
                        <th width="140">Trạng thái</th>
                        <th>Địa chỉ</th>
                        <th width="120" class="text-end">Diện tích</th>
                        <th width="120">Ngày tạo</th>
                        <th width="130" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 0;
                    }
                    @foreach (var item in Model)
                    {
                        index++;
                        <tr>
                            <td class="text-center text-muted">@index</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="location-icon bg-primary-subtle text-primary rounded d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px;">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@item.Name</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <small class="text-muted text-truncate d-block"
                                                   style="max-width: 200px;">
                                                @item.Description
                                            </small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info">
                                    <i class="bi bi-tag me-1"></i>
                                    @(item.LocationTypeName ?? "—")
                                </span>
                            </td>
                            <td>
                                @{
                                    var statusClass = item.LocationStatusName?.ToLower() switch
                                    {
                                        var s when s?.Contains("hoạt động") == true ||
                                        s?.Contains("active") == true => "success",
                                        var s when s?.Contains("bảo trì") == true ||
                                        s?.Contains("maintenance") == true => "warning",
                                        var s when s?.Contains("ngừng") == true ||
                                        s?.Contains("inactive") == true => "secondary",
                                        _ => "primary"
                                    };
                                }
                                <span class="badge bg-@statusClass-subtle text-@statusClass">
                                    <i class="bi bi-circle-fill me-1"
                                       style="font-size: 0.5rem;"></i>
                                    @(item.LocationStatusName ?? "—")
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Address))
                                {
                                    <span class="text-muted" title="@item.Address">
                                        <i class="bi bi-pin-map me-1"></i>
                                        @(item.Address.Length > 30
                                                                    ? item.Address.Substring(0, 30) + "..."
                                                                    : item.Address)
                        </span>
                                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.Area.HasValue)
                                {
                                    <span class="fw-medium">
                                        @item.Area.Value.ToString("N0")
                                    </span>
                                    <small class="text-muted">m²</small>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>
                                    @(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "—")
                                </small>
                            </td>
                            <td class="text-center">
                                <partial name="_ActionButtons"
                                         model="@(new ActionButtonsModel(item.Id, "Location", item.Name))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <partial name="_EmptyState"
                 model="@(EmptyStateModel.NoData("vị trí", "/Location/Create"))" />
    }
</div>

@* ==================== Delete Modal ==================== *@
<partial name="_DeleteModal" model="deleteModal" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize DataTable with quick search
            FarmApp.DataTable.init('#locationTable', {
                searchInput: '#quickSearch',
                sortable: true,
                highlightMatches: true,
                searchableColumns: [1, 2, 3, 4] // Name, Type, Status, Address
            });

            // Initialize tooltips
            FarmApp.UI.initTooltips();
        });
    </script>
}

<style>
    .location-icon {
        flex-shrink: 0;
    }

    .bg-primary-subtle {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    .bg-warning-subtle {
        background-color: rgba(255, 193, 7, 0.15) !important;
    }

    .bg-info-subtle {
        background-color: rgba(13, 202, 240, 0.1) !important;
    }

    .bg-secondary-subtle {
        background-color: rgba(108, 117, 125, 0.1) !important;
    }
</style>
