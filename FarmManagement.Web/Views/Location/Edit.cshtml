@using FarmManagement.Application.DTOs.Locations
@model LocationDto

@{
    ViewData["Title"] = "Sửa vị trí";
    ViewData["Breadcrumb"] = "Sửa vị trí";
}

<div class="page-header mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Location" asp-action="Index">Vị trí</a>
            </li>
            <li class="breadcrumb-item active">Sửa</li>
        </ol>
    </nav>
    <h1 class="page-title">Sửa vị trí</h1>
    <p class="page-subtitle">Cập nhật thông tin vị trí #@Model.Id</p>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-pencil me-2"></i>Thông tin cơ bản
                    </h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-geo-alt me-1"></i>Tên vị trí <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="bi bi-tag me-1"></i>Loại vị trí <span class="text-danger">*</span>
                            </label>
                            <select asp-for="LocationTypeId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Types, "Id", "Name"))">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="bi bi-toggle-on me-1"></i>Trạng thái <span class="text-danger">*</span>
                            </label>
                            <select asp-for="LocationStatusId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Statuses, "Id", "Name"))">
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label">
                                <i class="bi bi-pin-map me-1"></i>Địa chỉ <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-text-paragraph me-1"></i>Mô tả <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chi tiết bổ sung -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-rulers me-2"></i>Thông tin chi tiết
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Area" class="form-label">
                                <i class="bi bi-bounding-box me-1"></i>Diện tích (m²)
                            </label>
                            <input asp-for="Area" type="number" step="0.01" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Capacity" class="form-label">
                                <i class="bi bi-box me-1"></i>Sức chứa
                            </label>
                            <input asp-for="Capacity" type="number" step="0.01" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CapacityUnit" class="form-label">
                                <i class="bi bi-hash me-1"></i>Đơn vị
                            </label>
                            <input asp-for="CapacityUnit" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">
                                <i class="bi bi-calendar-event me-1"></i>Ngày bắt đầu
                            </label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label">
                                <i class="bi bi-calendar-x me-1"></i>Ngày kết thúc
                            </label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Note" class="form-label">
                                <i class="bi bi-sticky me-1"></i>Ghi chú
                            </label>
                            <textarea asp-for="Note" rows="2" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 80px;">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>Thao tác
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Hủy
                        </a>
                    </div>
                </div>
            </div>

            <!-- Info card -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Thông tin
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block">ID</small>
                        <strong>@Model.Id</strong>
                    </div>
                    @if (Model.CreatedDate.HasValue)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Ngày tạo</small>
                            <strong>@Model.CreatedDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    }
                    @if (Model.UpdatedDate.HasValue)
                    {
                        <div>
                            <small class="text-muted d-block">Cập nhật lần cuối</small>
                            <strong>@Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Danger Zone -->
            <div class="card border-danger mt-3">
                <div class="card-header bg-danger bg-opacity-10 border-danger">
                    <h5 class="card-title mb-0 text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>Vùng nguy hiểm
                    </h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">Các thao tác không thể hoàn tác</p>
                    <a asp-action="Delete" asp-route-id="@Model.Id"
                       class="btn btn-outline-danger btn-sm w-100"
                       onclick="return confirm('Bạn có chắc chắn muốn xóa vị trí này?');">
                        <i class="bi bi-trash me-1"></i>Xóa vị trí này
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}