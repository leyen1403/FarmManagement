@using FarmManagement.Application.DTOs.Locations
@model LocationDto

@{
    ViewData["Title"] = $"Sửa vị trí: {Model.Name}";

    // Breadcrumbs
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        new BreadcrumbItem("Vị trí", "/Location", "bi bi-geo-alt"),
        BreadcrumbItem.Current("Chỉnh sửa")
    );

    // Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = "Chỉnh sửa vị trí",
        Subtitle = $"Cập nhật thông tin vị trí #{Model.Id}: {Model.Name}",
        Icon = "bi bi-pencil-square",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            ActionButtonModel.Back("/Location", "Quay lại"),
            ActionButtonModel.Details($"/Location/Details/{Model.Id}", "Xem chi tiết")
        }
    };

    // Delete Modal
    var deleteModal = new DeleteModalModel
    {
        ControllerName = "Location",
        Title = "Xác nhận xóa vị trí",
        Message = $"Bạn có chắc chắn muốn xóa vị trí \"{Model.Name}\"?",
        WarningMessage = "Hành động này không thể hoàn tác. Tất cả dữ liệu liên quan sẽ bị ảnh hưởng."
    };
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

@* ==================== Form ==================== *@
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <form asp-action="Edit" method="post" data-validate="true">
            <input type="hidden" asp-for="Id" />

            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-pencil text-primary me-2"></i>
                        Thông tin vị trí
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">
                        ID: @Model.Id
                    </span>
                </div>

                <div class="card-body">
                    @* Validation Summary *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @* ==================== Section 1: Thông tin cơ bản ==================== *@
                    <div class="form-section mb-4">
                        <h6 class="form-section-title text-primary mb-3">
                            <i class="bi bi-info-circle me-2"></i>
                            Thông tin cơ bản
                        </h6>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label">
                                    Tên vị trí <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-geo-alt"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control" required />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LocationTypeId" class="form-label">
                                    Loại vị trí <span class="text-danger">*</span>
                                </label>
                                <select asp-for="LocationTypeId"
                                        class="form-select"
                                        required
                                        asp-items="@(new SelectList(ViewBag.Types, "Id", "Name"))">
                                    <option value="">-- Chọn loại vị trí --</option>
                                </select>
                                <span asp-validation-for="LocationTypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LocationStatusId" class="form-label">
                                    Trạng thái <span class="text-danger">*</span>
                                </label>
                                <select asp-for="LocationStatusId"
                                        class="form-select"
                                        required
                                        asp-items="@(new SelectList(ViewBag.Statuses, "Id", "Name"))">
                                    <option value="">-- Chọn trạng thái --</option>
                                </select>
                                <span asp-validation-for="LocationStatusId" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label">
                                    Địa chỉ
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-pin-map"></i>
                                    </span>
                                    <input asp-for="Address" class="form-control" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">
                                    Mô tả
                                </label>
                                <textarea asp-for="Description"
                                          rows="3"
                                          class="form-control"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    @* ==================== Section 2: Thông tin chi tiết ==================== *@
                    <div class="form-section mb-4">
                        <h6 class="form-section-title text-primary mb-3">
                            <i class="bi bi-rulers me-2"></i>
                            Thông tin chi tiết
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Area" class="form-label">
                                    Diện tích
                                </label>
                                <div class="input-group">
                                    <input asp-for="Area"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />
                                    <span class="input-group-text">m²</span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Capacity" class="form-label">
                                    Sức chứa
                                </label>
                                <input asp-for="Capacity"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CapacityUnit" class="form-label">
                                    Đơn vị sức chứa
                                </label>
                                <input asp-for="CapacityUnit" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label">
                                    Ngày bắt đầu sử dụng
                                </label>
                                <input asp-for="StartDate"
                                       type="date"
                                       class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label">
                                    Ngày kết thúc
                                </label>
                                <input asp-for="EndDate"
                                       type="date"
                                       class="form-control" />
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    @* ==================== Section 3: Ghi chú ==================== *@
                    <div class="form-section">
                        <h6 class="form-section-title text-primary mb-3">
                            <i class="bi bi-sticky me-2"></i>
                            Ghi chú
                        </h6>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Note" class="form-label">
                                    Ghi chú bổ sung
                                </label>
                                <textarea asp-for="Note"
                                          rows="3"
                                          class="form-control"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                @* ==================== Form Actions ==================== *@
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i>
                            Các trường có dấu <span class="text-danger">*</span> là bắt buộc
                        </span>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg me-1"></i>
                                Hủy
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Cập nhật
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        @* ==================== Info Card ==================== *@
        <div class="card mt-3">
            <div class="card-header bg-white">
                <h6 class="mb-0">
                    <i class="bi bi-clock-history text-info me-2"></i>
                    Lịch sử
                </h6>
            </div>
            <div class="card-body py-3">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-success-subtle text-success rounded p-2">
                                <i class="bi bi-calendar-plus"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Ngày tạo</small>
                                <strong>
                                    @(Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-info-subtle text-info rounded p-2">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Cập nhật lần cuối</small>
                                <strong>
                                    @(Model.UpdatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ==================== Danger Zone ==================== *@
        <div class="card mt-3 border-danger">
            <div class="card-header bg-danger-subtle border-danger">
                <h6 class="mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Vùng nguy hiểm
                </h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 fw-medium">Xóa vị trí này</p>
                        <p class="text-muted small mb-0">
                            Hành động này không thể hoàn tác
                        </p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-entity-id="@Model.Id"
                            data-entity-name="@Model.Name">
                        <i class="bi bi-trash me-1"></i>
                        Xóa vị trí
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ==================== Delete Modal ==================== *@
<partial name="_DeleteModal" model="deleteModal" />

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            FarmApp.UI.initTooltips();
        });
    </script>
}

<style>
    .form-section-title {
        font-size: 0.9375rem;
        font-weight: 600;
        border-bottom: 2px solid var(--bs-primary);
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .bg-primary-subtle {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    .bg-info-subtle {
        background-color: rgba(13, 202, 240, 0.1) !important;
    }

    .bg-danger-subtle {
        background-color: rgba(220, 53, 69, 0.1) !important;
    }
</style>
