@model List<FarmManagement.Application.DTOs.Crops.CropDto>
@using FarmManagement.Application.DTOs.Crops
@using FarmManagement.Application.DTOs.Locations

@{
    ViewData["Title"] = "Quản lý cây trồng";

    // Breadcrumbs
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        BreadcrumbItem.Current("Cây trồng", "bi bi-flower2")
    );

    var cropTypes = ViewBag.CropTypes as List<CropTypeDto> ?? new List<CropTypeDto>();
    var cropStatuses = ViewBag.CropStatuses as IEnumerable<CropStatusDto> ?? new List<CropStatusDto>();
    var locations = ViewBag.Locations as List<LocationDto> ?? new List<LocationDto>();

    int? selectedCropTypeId = ViewBag.SelectedCropTypeId;
    int? selectedCropStatusId = ViewBag.SelectedCropStatusId;
    int? selectedLocationId = ViewBag.SelectedLocationId;
    var searchTerm = Context.Request.Query["searchTerm"].ToString();

    // Stats Logic
    var totalCount = Model.Count;
    var growingCount = Model.Count(c => c.CropStatusName?.Contains("Đang") == true || c.CropStatusId == 1);
    var upcomingHarvestCount = Model.Count(c => c.ExpectedHarvestDate.HasValue && c.ExpectedHarvestDate.Value <= DateTime.Today.AddDays(30) && !c.ActualHarvestDate.HasValue);
    var harvestedCount = Model.Count(c => c.ActualHarvestDate.HasValue);

    // Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = "Quản lý cây trồng",
        Subtitle = "Theo dõi và quản lý cây trồng trong trang trại",
        Icon = "bi bi-flower2",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            new ActionButtonModel("Xuất Excel", "#", "bi bi-file-earmark-excel", "btn-outline-success") { Size = ButtonSize.Small },
            ActionButtonModel.Create("/Crop/Create", "Thêm cây trồng")
        }
    };

    // Stats Cards
    var statsCards = new List<StatsCardModel>
    {
        new StatsCardModel
        {
            Value = totalCount.ToString(),
            Label = "Tổng cây trồng",
            Icon = "bi bi-flower2",
            IconBackgroundClass = "bg-primary-subtle",
            ColorClass = "text-primary"
        },
        new StatsCardModel
        {
            Value = growingCount.ToString(),
            Label = "Đang trồng",
            Icon = "bi bi-tree",
            IconBackgroundClass = "bg-success-subtle",
            ColorClass = "text-success"
        },
        new StatsCardModel
        {
            Value = upcomingHarvestCount.ToString(),
            Label = "Sắp thu hoạch",
            Icon = "bi bi-calendar-check",
            IconBackgroundClass = "bg-warning-subtle",
            ColorClass = "text-warning",
            TrendDescription = "trong 30 ngày"
        },
        new StatsCardModel
        {
            Value = harvestedCount.ToString(),
            Label = "Đã thu hoạch",
            Icon = "bi bi-basket",
            IconBackgroundClass = "bg-info-subtle",
            ColorClass = "text-info"
        }
    };

    // Filter Form
    var filterForm = new FilterFormModel
    {
        ActionUrl = "/Crop",
        Method = "GET",
        Title = "Bộ lọc tìm kiếm",
        Icon = "bi bi-funnel",
        IsExpanded = !string.IsNullOrEmpty(searchTerm) || selectedCropTypeId.HasValue || selectedCropStatusId.HasValue || selectedLocationId.HasValue,
        ResetUrl = "/Crop",
        ColumnsPerRow = 4,
        Fields = new List<FilterFieldModel>
        {
            new FilterFieldModel
            {
                Name = "searchTerm",
                Label = "Tìm kiếm",
                Type = FilterFieldType.Text,
                Value = searchTerm,
                Placeholder = "Tên cây trồng...",
                Icon = "bi bi-search",
                ColSpan = 3
            },
            new FilterFieldModel
            {
                Name = "cropTypeId",
                Label = "Loại cây trồng",
                Type = FilterFieldType.Select,
                Value = selectedCropTypeId?.ToString(),
                Placeholder = "Tất cả loại",
                ColSpan = 3,
                Options = cropTypes.Select(t => new SelectOptionModel(t.Id.ToString(), t.Name, t.Id == selectedCropTypeId)).ToList()
            },
            new FilterFieldModel
            {
                Name = "cropStatusId",
                Label = "Trạng thái",
                Type = FilterFieldType.Select,
                Value = selectedCropStatusId?.ToString(),
                Placeholder = "Tất cả trạng thái",
                ColSpan = 3,
                Options = cropStatuses.Select(s => new SelectOptionModel(s.Id.ToString(), s.Name, s.Id == selectedCropStatusId)).ToList()
            },
            new FilterFieldModel
            {
                Name = "locationId",
                Label = "Vị trí",
                Type = FilterFieldType.Select,
                Value = selectedLocationId?.ToString(),
                Placeholder = "Tất cả vị trí",
                ColSpan = 3,
                Options = locations.Select(l => new SelectOptionModel(l.Id.ToString(), l.Name, l.Id == selectedLocationId)).ToList()
            }
        }
    };

    // Delete Modal
    var deleteModal = DeleteModalModel.ForEntity("cây trồng", "Crop");
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

@* ==================== Stats Cards ==================== *@
<partial name="_StatsCards" model="statsCards" />

@* ==================== Filter Form ==================== *@
<partial name="_FilterForm" model="filterForm" />

@* ==================== Data Table ==================== *@
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <div class="d-flex align-items-center gap-2">
            <h6 class="card-title mb-0 fw-semibold">
                <i class="bi bi-list-ul text-success me-2"></i>Danh sách cây trồng
            </h6>
            <span class="badge bg-success">@totalCount</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 250px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" id="quickSearch" placeholder="Tìm nhanh trong bảng...">
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="cropTable">
                <thead class="bg-light">
                    <tr>
                        <th width="50" class="text-center">#</th>
                        <th>Tên cây</th>
                        <th width="130">Loại cây</th>
                        <th width="150">Vị trí</th>
                        <th width="110">Ngày trồng</th>
                        <th width="140">Dự kiến thu hoạch</th>
                        <th width="120">Trạng thái</th>
                        <th width="130" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 0;
                    }
                    @foreach (var item in Model)
                    {
                        index++;
                        <tr>
                            <td class="text-center text-muted">@index</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="crop-icon bg-success-subtle text-success rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-flower2"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@item.Name</div>
                                        @if (item.EstimatedYield.HasValue)
                                        {
                                            <small class="text-muted">
                                                <i class="bi bi-basket me-1"></i>Dự kiến: @item.EstimatedYield.Value.ToString("N0") @item.Unit
                                            </small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info">
                                    <i class="bi bi-tag me-1"></i>@item.CropTypeName
                                </span>
                            </td>
                            <td>
                                <span class="text-muted">
                                    <i class="bi bi-geo-alt me-1"></i>@item.LocationName
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>@item.PlantDate.ToString("dd/MM/yyyy")
                                </small>
                            </td>
                            <td>
                                @if (item.ExpectedHarvestDate.HasValue)
                                {
                                    var daysLeft = (item.ExpectedHarvestDate.Value - DateTime.Today).Days;
                                    <small>
                                        <i class="bi bi-calendar-check me-1 text-muted"></i>
                                        @item.ExpectedHarvestDate.Value.ToString("dd/MM/yyyy")
                                    </small>
                                    @if (!item.ActualHarvestDate.HasValue)
                                    {
                                        if (daysLeft > 0 && daysLeft <= 30)
                                        {
                                            <span class="badge bg-warning-subtle text-warning ms-1">@daysLeft ngày</span>
                                        }
                                        else if (daysLeft <= 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger ms-1">Quá hạn</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @{
                                    var statusClass = item.CropStatusName switch
                                    {
                                        var s when s?.Contains("Thu hoạch") == true => "success",
                                        var s when s?.Contains("Đang") == true => "primary",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@statusClass-subtle text-@statusClass">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                                    @item.CropStatusName
                                </span>
                            </td>
                            <td class="text-center">
                                <partial name="_ActionButtons" model="@(new ActionButtonsModel(item.Id, "Crop", item.Name) { ShowDetails = true })" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <partial name="_EmptyState" model="@(EmptyStateModel.NoData("cây trồng", "/Crop/Create"))" />
    }
</div>

@* ==================== Delete Modal ==================== *@
<partial name="_DeleteModal" model="deleteModal" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize DataTable
            FarmApp.DataTable.init('#cropTable', {
                searchInput: '#quickSearch',
                sortable: true,
                highlightMatches: true,
                searchableColumns: [1, 2, 3, 6] // Name, Type, Location, Status
            });

            // Initialize tooltips
            FarmApp.UI.initTooltips();
        });
    </script>
}

<style>
    .crop-icon {
        flex-shrink: 0;
    }

    .bg-primary-subtle {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    .bg-warning-subtle {
        background-color: rgba(255, 193, 7, 0.15) !important;
    }

    .bg-info-subtle {
        background-color: rgba(13, 202, 240, 0.1) !important;
    }

    .bg-danger-subtle {
        background-color: rgba(220, 53, 69, 0.1) !important;
    }

    .bg-secondary-subtle {
        background-color: rgba(108, 117, 125, 0.1) !important;
    }
</style>