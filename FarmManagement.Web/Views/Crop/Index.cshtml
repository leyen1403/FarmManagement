@model List<FarmManagement.Application.DTOs.Crops.CropDto>
@using FarmManagement.Application.DTOs.Crops
@using FarmManagement.Application.DTOs.Locations

@{
    ViewData["Title"] = "Quản lý cây trồng";
    ViewData["Breadcrumb"] = "Cây trồng";

    var cropTypes = ViewBag.CropTypes as List<CropTypeDto> ?? new List<CropTypeDto>();
    var cropStatuses = ViewBag.CropStatuses as IEnumerable<CropStatusDto> ?? new List<CropStatusDto>();
    var locations = ViewBag.Locations as List<LocationDto> ?? new List<LocationDto>();

    int? selectedCropTypeId = ViewBag.SelectedCropTypeId;
    int? selectedCropStatusId = ViewBag.SelectedCropStatusId;
    int? selectedLocationId = ViewBag.SelectedLocationId;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Quản lý cây trồng</h1>
        <p class="page-subtitle mb-0">Theo dõi và quản lý cây trồng trong trang trại</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Thêm cây trồng
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@Model.Count</div>
                    <div class="stats-card-label">Tổng cây trồng</div>
                </div>
                <div class="stats-card-icon primary">
                    <i class="bi bi-flower2"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@Model.Count(c => c.CropStatusName?.Contains("Đang") == true || c.CropStatusId == 1)</div>
                    <div class="stats-card-label">Đang trồng</div>
                </div>
                <div class="stats-card-icon success">
                    <i class="bi bi-tree"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@Model.Count(c => c.ExpectedHarvestDate.HasValue && c.ExpectedHarvestDate.Value <= DateTime.Today.AddDays(30))</div>
                    <div class="stats-card-label">Sắp thu hoạch</div>
                </div>
                <div class="stats-card-icon warning">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stats-card-value">@Model.Count(c => c.ActualHarvestDate.HasValue)</div>
                    <div class="stats-card-label">Đã thu hoạch</div>
                </div>
                <div class="stats-card-icon danger">
                    <i class="bi bi-basket"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Card -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-funnel me-2"></i>Bộ lọc
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Loại cây trồng</label>
                    <select name="cropTypeId" class="form-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var ct in cropTypes)
                        {
                            <option value="@ct.Id" selected="@(selectedCropTypeId == ct.Id)">@ct.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="cropStatusId" class="form-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var cs in cropStatuses)
                        {
                            <option value="@cs.Id" selected="@(selectedCropStatusId == cs.Id)">@cs.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Vị trí</label>
                    <select name="locationId" class="form-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var loc in locations)
                        {
                            <option value="@loc.Id" selected="@(selectedLocationId == loc.Id)">@loc.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Xóa lọc
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="table-container">
    <div class="table-toolbar">
        <div class="table-search">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm cây trồng...">
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-secondary">Hiển thị: @Model.Count</span>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table data-table mb-0" id="dataTable">
                <thead>
                    <tr>
                        <th width="50">#</th>
                        <th>Tên cây</th>
                        <th>Loại cây</th>
                        <th>Vị trí</th>
                        <th>Ngày trồng</th>
                        <th>Dự kiến thu hoạch</th>
                        <th>Trạng thái</th>
                        <th width="180">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 text-success rounded p-2 me-2">
                                        <i class="bi bi-flower2"></i>
                                    </div>
                                    <div>
                                        <span class="fw-medium">@item.Name</span>
                                        @if (item.EstimatedYield.HasValue)
                                        {
                                            <small class="d-block text-muted">
                                                Năng suất dự kiến: @item.EstimatedYield @item.Unit
                                            </small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info">
                                    @item.CropTypeName
                                </span>
                            </td>
                            <td>
                                <i class="bi bi-geo-alt text-muted me-1"></i>
                                @item.LocationName
                            </td>
                            <td>
                                <i class="bi bi-calendar3 text-muted me-1"></i>
                                @item.PlantDate.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @if (item.ExpectedHarvestDate.HasValue)
                                {
                                    var daysLeft = (item.ExpectedHarvestDate.Value - DateTime.Today).Days;
                                    <i class="bi bi-calendar-check text-muted me-1"></i>
                                    @item.ExpectedHarvestDate.Value.ToString("dd/MM/yyyy")
                                    @if (daysLeft > 0 && daysLeft <= 30)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">@daysLeft ngày</span>
                                    }
                                    else if (daysLeft <= 0 && !item.ActualHarvestDate.HasValue)
                                    {
                                        <span class="badge bg-danger ms-1">Quá hạn</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @{
                                    var statusClass = item.CropStatusName switch
                                    {
                                        var s when s?.Contains("Thu hoạch") == true => "badge-active",
                                        var s when s?.Contains("Đang") == true => "bg-primary",
                                        _ => "badge-inactive"
                                    };
                                }
                                <span class="badge badge-status @statusClass">
                                    @item.CropStatusName
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            title="Xóa"
                                            onclick="confirmDelete(@item.Id, '@item.Name')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-flower2"></i>
            </div>
            <div class="empty-state-title">Chưa có cây trồng</div>
            <p class="text-muted">Bắt đầu bằng cách thêm cây trồng đầu tiên</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Thêm cây trồng
            </a>
        </div>
    }
</div>

<!-- Delete Form (hidden) -->
<form id="deleteForm" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa cây trồng <strong id="deleteItemName"></strong>?</p>
                <p class="text-muted small mb-0">Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="submitDelete()">
                    <i class="bi bi-trash me-1"></i>Xóa
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
            // Search functionality
                document.getElementById('searchInput').addEventListener('keyup', function() {
        const filter = this.value.toLowerCase();
             const rows = document.querySelectorAll('#dataTable tbody tr');
             rows.forEach(row => {
             const text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? '' : 'none';
            });
           });

                // Delete confirmation
                function confirmDelete(id, name) {
              document.getElementById('deleteItemName').textContent = name;
         document.getElementById('deleteId').value = id;
               new bootstrap.Modal(document.getElementById('deleteModal')).show();
                }

                function submitDelete() {
              document.getElementById('deleteForm').submit();
                }
    </script>
}
