@section Scripts {
    <script>
        function editHarvest(id, date, quantity, unit, unitPrice, buyer, note) {
            document.getElementById('editHarvestId').value = id;
            document.getElementById('editHarvestDate').value = date;
          document.getElementById('editHarvestQuantity').value = quantity;
            document.getElementById('editHarvestUnit').value = unit;
         document.getElementById('editHarvestUnitPrice').value = unitPrice;
          document.getElementById('editHarvestBuyer').value = buyer;
          document.getElementById('editHarvestNote').value = note;
   new bootstrap.Modal(document.getElementById('editHarvestModal')).show();
     }

 function confirmDeleteHarvest(id, date) {
            document.getElementById('deleteHarvestId').value = id;
            document.getElementById('deleteHarvestDate').textContent = date;
  new bootstrap.Modal(document.getElementById('deleteHarvestModal')).show();
        }

        function editCost(id, costTypeId, date, quantity, unit, unitPrice, note) {
            document.getElementById('editCostId').value = id;
    document.getElementById('editCostTypeId').value = costTypeId;
            document.getElementById('editCostDate').value = date;
            document.getElementById('editCostQuantity').value = quantity;
            document.getElementById('editCostUnit').value = unit;
            document.getElementById('editCostUnitPrice').value = unitPrice;
     document.getElementById('editCostNote').value = note;
            new bootstrap.Modal(document.getElementById('editCostModal')).show();
        }

        function confirmDeleteCost(id, name) {
            document.getElementById('deleteCostId').value = id;
         document.getElementById('deleteCostName').textContent = name;
        new bootstrap.Modal(document.getElementById('deleteCostModal')).show();
   }

        function editCareLog(id, careTypeId, date, description, cost) {
            document.getElementById('editCareLogId').value = id;
            document.getElementById('editCareLogTypeId').value = careTypeId;
    document.getElementById('editCareLogDate').value = date;
document.getElementById('editCareLogDescription').value = description;
       document.getElementById('editCareLogCost').value = cost;
        new bootstrap.Modal(document.getElementById('editCareLogModal')).show();
        }

        function confirmDeleteCareLog(id, name) {
            document.getElementById('deleteCareLogId').value = id;
          document.getElementById('deleteCareLogName').textContent = name;
          new bootstrap.Modal(document.getElementById('deleteCareLogModal')).show();
        }

      function editPrice(id, price, unit, effectiveDate, expiryDate, note, isActive) {
  document.getElementById('editPriceId').value = id;
     document.getElementById('editPrice').value = price;
       document.getElementById('editUnit').value = unit;
            document.getElementById('editEffectiveDate').value = effectiveDate;
 document.getElementById('editExpiryDate').value = expiryDate || '';
  document.getElementById('editNote').value = note || '';
        document.getElementById('editIsActive').checked = isActive;
  new bootstrap.Modal(document.getElementById('editPriceModal')).show();
        }

        function confirmDeletePrice(id, price) {
       document.getElementById('deletePriceId').value = id;
     document.getElementById('deletePriceValue').textContent = price.toLocaleString('vi-VN');
        new bootstrap.Modal(document.getElementById('deletePriceModal')).show();
      }
    </script>
}
