@model FarmManagement.Application.DTOs.Crops.CropDto
@using FarmManagement.Application.DTOs.Crops

@{
    ViewData["Title"] = $"Chi tiết: {Model.Name}";

    // Breadcrumbs
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        new BreadcrumbItem("Cây trồng", "/Crop", "bi bi-flower2"),
        BreadcrumbItem.Current("Chi tiết")
    );

    var daysPlanted = (DateTime.Today - Model.PlantDate).Days;
    var daysToHarvest = Model.ExpectedHarvestDate.HasValue
        ? (Model.ExpectedHarvestDate.Value - DateTime.Today).Days
        : (int?)null;
    var progress = Model.ExpectedHarvestDate.HasValue
        ? Math.Min(100, Math.Max(0, (int)((double)daysPlanted / (Model.ExpectedHarvestDate.Value - Model.PlantDate).Days * 100)))
        : 0;

    var priceHistory = ViewBag.PriceHistory as List<CropPriceDto> ?? new List<CropPriceDto>();
    var currentPrice = priceHistory.FirstOrDefault(p => p.IsActive);
    var harvests = ViewBag.Harvests as List<CropHarvestDto> ?? new List<CropHarvestDto>();
    var costs = ViewBag.Costs as List<CropCostDto> ?? new List<CropCostDto>();
    var careLogs = ViewBag.CareLogs as List<CropCareLogDto> ?? new List<CropCareLogDto>();
    var costTypes = ViewBag.CostTypes as List<CostTypeDto> ?? new List<CostTypeDto>();
    var careTypes = ViewBag.CareTypes as List<CropCareTypeDto> ?? new List<CropCareTypeDto>();

    var totalHarvestAmount = harvests.Sum(h => h.TotalAmount);
    var totalCostAmount = costs.Sum(c => c.TotalAmount);
    var totalCareLogCost = careLogs.Sum(c => c.Cost);
    var profit = totalHarvestAmount - totalCostAmount - totalCareLogCost;

    // Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = Model.Name,
        Subtitle = $"{Model.CropTypeName} • {Model.LocationName}",
        Icon = "bi bi-flower2",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            ActionButtonModel.Back("/Crop", "Quay lại"),
            new ActionButtonModel("Sửa", $"/Crop/Edit/{Model.Id}", "bi bi-pencil", "btn-primary") { Size = ButtonSize.Default }
        }
    };

    // Stats Cards
    var statsCards = new List<StatsCardModel>
    {
        new StatsCardModel
        {
            Value = totalHarvestAmount.ToString("N0"),
            Label = "Doanh thu (VNĐ)",
            Icon = "bi bi-basket",
            IconBackgroundClass = "bg-success-subtle",
            ColorClass = "text-success"
        },
        new StatsCardModel
        {
            Value = (totalCostAmount + totalCareLogCost).ToString("N0"),
            Label = "Chi phí (VNĐ)",
            Icon = "bi bi-wallet2",
            IconBackgroundClass = "bg-danger-subtle",
            ColorClass = "text-danger"
        },
        new StatsCardModel
        {
            Value = profit.ToString("N0"),
            Label = "Lợi nhuận (VNĐ)",
            Icon = "bi bi-graph-up-arrow",
            IconBackgroundClass = profit >= 0 ? "bg-primary-subtle" : "bg-danger-subtle",
            ColorClass = profit >= 0 ? "text-primary" : "text-danger"
        },
        new StatsCardModel
        {
            Value = careLogs.Count.ToString(),
            Label = "Lần chăm sóc",
            Icon = "bi bi-calendar-check",
            IconBackgroundClass = "bg-warning-subtle",
            ColorClass = "text-warning"
        }
    };

    // Empty states
    var emptyHarvest = EmptyStateModel.NoData("thu hoạch");
    emptyHarvest.Icon = "bi bi-basket";
    emptyHarvest.IconSize = "2rem";
    emptyHarvest.PrimaryAction = null;

    var emptyCost = EmptyStateModel.NoData("chi phí");
    emptyCost.Icon = "bi bi-wallet2";
    emptyCost.IconSize = "2rem";
    emptyCost.PrimaryAction = null;

    var emptyCare = EmptyStateModel.NoData("nhật ký chăm sóc");
    emptyCare.Icon = "bi bi-calendar-check";
    emptyCare.IconSize = "2rem";
    emptyCare.PrimaryAction = null;

    var emptyPrice = EmptyStateModel.NoData("lịch sử giá");
    emptyPrice.Icon = "bi bi-currency-dollar";
    emptyPrice.IconSize = "2rem";
    emptyPrice.PrimaryAction = null;
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

@* ==================== Stats Cards ==================== *@
<partial name="_StatsCards" model="statsCards" />

<div class="row g-4">
    @* ==================== Left Column - Main Content ==================== *@
    <div class="col-lg-8">
        @* Basic Info Card *@
        <div class="card mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-flower2 text-success me-2"></i>Thông tin cây trồng
                </h6>
                @{
                    var statusClass = Model.ActualHarvestDate.HasValue ? "success" : "primary";
                }
                <span class="badge bg-@statusClass-subtle text-@statusClass">@Model.CropStatusName</span>
            </div>
            <div class="card-body">
                @* Progress Bar *@
                @if (!Model.ActualHarvestDate.HasValue && Model.ExpectedHarvestDate.HasValue)
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-medium">Tiến độ sinh trưởng</span>
                            <span class="text-muted">@progress%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            @{
                                var progressClass = progress >= 90 ? "bg-success" : progress >= 50 ? "bg-primary" : "bg-warning";
                            }
                            <div class="progress-bar @progressClass" role="progressbar" style="width: @progress%;"></div>
                        </div>
                        <small class="text-muted">
                            @if (daysToHarvest.HasValue && daysToHarvest > 0)
                            {
                                <text>Còn <strong>@daysToHarvest ngày</strong> đến ngày dự kiến thu hoạch</text>
                            }
                            else if (daysToHarvest.HasValue && daysToHarvest <= 0)
                            {
                                <span class="text-danger">Đã quá hạn thu hoạch @Math.Abs(daysToHarvest.Value) ngày</span>
                            }
                        </small>
                    </div>
                }

                @* Info Grid *@
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-box border rounded p-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary rounded p-2">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Ngày trồng</small>
                                    <strong>@Model.PlantDate.ToString("dd/MM/yyyy")</strong>
                                    <small class="text-muted d-block">@daysPlanted ngày trước</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box border rounded p-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning-subtle text-warning rounded p-2">
                                    <i class="bi bi-calendar-check"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Dự kiến thu hoạch</small>
                                    <strong>@(Model.ExpectedHarvestDate?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-box border rounded p-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-info-subtle text-info rounded p-2">
                                    <i class="bi bi-basket"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Năng suất dự kiến</small>
                                    <strong>@(Model.EstimatedYield?.ToString("N0") ?? "—") @Model.Unit</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (currentPrice != null)
                    {
                        <div class="col-md-6">
                            <div class="info-box border border-success rounded p-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-success-subtle text-success rounded p-2">
                                        <i class="bi bi-currency-dollar"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Giá hiện tại</small>
                                        <strong class="text-success">@currentPrice.Price.ToString("N0") VNĐ/@currentPrice.Unit</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mt-4 p-3 bg-light rounded">
                        <h6 class="mb-2"><i class="bi bi-sticky me-2"></i>Ghi chú</h6>
                        <p class="mb-0 text-muted">@Model.Note</p>
                    </div>
                }
            </div>
        </div>

        @* ==================== Tabs Management ==================== *@
        <div class="card">
            <div class="card-header bg-white p-0">
                <ul class="nav nav-tabs card-header-tabs" id="cropTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active px-4 py-3" id="harvest-tab" data-bs-toggle="tab" data-bs-target="#harvest" type="button">
                            <i class="bi bi-basket me-2"></i>Thu hoạch
                            <span class="badge bg-success ms-2">@harvests.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3" id="cost-tab" data-bs-toggle="tab" data-bs-target="#cost" type="button">
                            <i class="bi bi-wallet2 me-2"></i>Chi phí
                            <span class="badge bg-danger ms-2">@costs.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3" id="care-tab" data-bs-toggle="tab" data-bs-target="#care" type="button">
                            <i class="bi bi-calendar-check me-2"></i>Chăm sóc
                            <span class="badge bg-warning text-dark ms-2">@careLogs.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3" id="price-tab" data-bs-toggle="tab" data-bs-target="#price" type="button">
                            <i class="bi bi-currency-dollar me-2"></i>Giá
                            <span class="badge bg-info ms-2">@priceHistory.Count</span>
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="cropTabsContent">
                    @* ==================== Tab: Thu hoạch ==================== *@
                    <div class="tab-pane fade show active" id="harvest" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0"><i class="bi bi-basket text-success me-2"></i>Danh sách thu hoạch</h6>
                            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addHarvestModal">
                                <i class="bi bi-plus-lg me-1"></i>Thêm thu hoạch
                            </button>
                        </div>
                        @if (harvests.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ngày</th>
                                            <th>Số lượng</th>
                                            <th>Đơn giá</th>
                                            <th>Tổng tiền</th>
                                            <th>Người mua</th>
                                            <th width="100">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var h in harvests.OrderByDescending(x => x.HarvestDate))
                                        {
                                            <tr>
                                                <td>@h.HarvestDate.ToString("dd/MM/yyyy")</td>
                                                <td>@h.Quantity.ToString("N2") @h.Unit</td>
                                                <td>@h.UnitPrice.ToString("N0") VNĐ</td>
                                                <td><strong class="text-success">@h.TotalAmount.ToString("N0") VNĐ</strong></td>
                                                <td>@(h.Buyer ?? "—")</td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-primary" title="Sửa"
                                                                onclick="editHarvest(@h.Id, '@h.HarvestDate.ToString("yyyy-MM-dd")', @h.Quantity, '@(h.Unit ?? "")', @h.UnitPrice, '@(h.Buyer ?? "")', '@(h.Note?.Replace("'", "\\'") ?? "")')">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger" title="Xóa"
                                                                onclick="confirmDeleteHarvest(@h.Id, '@h.HarvestDate.ToString("dd/MM/yyyy")')">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="3" class="text-end"><strong>Tổng cộng:</strong></td>
                                            <td colspan="3"><strong class="text-success">@totalHarvestAmount.ToString("N0") VNĐ</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <partial name="_EmptyState" model="emptyHarvest" />
                        }
                    </div>

                    @* ==================== Tab: Chi phí ==================== *@
                    <div class="tab-pane fade" id="cost" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0"><i class="bi bi-wallet2 text-danger me-2"></i>Danh sách chi phí</h6>
                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#addCostModal">
                                <i class="bi bi-plus-lg me-1"></i>Thêm chi phí
                            </button>
                        </div>
                        @if (costs.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ngày</th>
                                            <th>Loại chi phí</th>
                                            <th>Số lượng</th>
                                            <th>Đơn giá</th>
                                            <th>Tổng tiền</th>
                                            <th width="100">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in costs.OrderByDescending(x => x.CostDate))
                                        {
                                            <tr>
                                                <td>@c.CostDate.ToString("dd/MM/yyyy")</td>
                                                <td><span class="badge bg-secondary">@c.CostTypeName</span></td>
                                                <td>@c.Quantity.ToString("N2") @c.Unit</td>
                                                <td>@c.UnitPrice.ToString("N0") VNĐ</td>
                                                <td><strong class="text-danger">@c.TotalAmount.ToString("N0") VNĐ</strong></td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-primary" title="Sửa"
                                                                onclick="editCost(@c.Id, @c.CostTypeId, '@c.CostDate.ToString("yyyy-MM-dd")', @c.Quantity, '@(c.Unit ?? "")', @c.UnitPrice, '@(c.Note?.Replace("'", "\\'") ?? "")')">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger" title="Xóa"
                                                                onclick="confirmDeleteCost(@c.Id, '@c.CostTypeName')">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="4" class="text-end"><strong>Tổng cộng:</strong></td>
                                            <td colspan="2"><strong class="text-danger">@totalCostAmount.ToString("N0") VNĐ</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <partial name="_EmptyState" model="emptyCost" />
                        }
                    </div>

                    @* ==================== Tab: Chăm sóc ==================== *@
                    <div class="tab-pane fade" id="care" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0"><i class="bi bi-calendar-check text-warning me-2"></i>Nhật ký chăm sóc</h6>
                            <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#addCareLogModal">
                                <i class="bi bi-plus-lg me-1"></i>Thêm chăm sóc
                            </button>
                        </div>
                        @if (careLogs.Any())
                        {
                            <div class="care-timeline">
                                @foreach (var log in careLogs.OrderByDescending(x => x.CareDate))
                                {
                                    var iconClass = log.CropCareTypeName switch
                                    {
                                        var n when n?.Contains("Tưới") == true => "bi-droplet text-info",
                                        var n when n?.Contains("Bón") == true => "bi-flower3 text-success",
                                        var n when n?.Contains("Phun") == true => "bi-bug text-warning",
                                        var n when n?.Contains("Làm cỏ") == true => "bi-scissors text-secondary",
                                        _ => "bi-calendar-event text-primary"
                                    };
                                    <div class="care-item d-flex mb-3 p-3 border rounded hover-shadow">
                                        <div class="care-icon bg-light rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi @iconClass"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <strong>@log.CropCareTypeName</strong>
                                                    <small class="text-muted d-block">@log.CareDate.ToString("dd/MM/yyyy")</small>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (log.Cost > 0)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger">@log.Cost.ToString("N0") VNĐ</span>
                                                    }
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-primary btn-sm" title="Sửa"
                                                                onclick="editCareLog(@log.Id, @log.CropCareTypeId, '@log.CareDate.ToString("yyyy-MM-dd")', '@(log.Description?.Replace("'", "\\'") ?? "")', @log.Cost)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm" title="Xóa"
                                                                onclick="confirmDeleteCareLog(@log.Id, '@log.CropCareTypeName')">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(log.Description))
                                            {
                                                <small class="text-muted mt-1 d-block">@log.Description</small>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="alert alert-info mt-3 mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                Tổng chi phí chăm sóc: <strong>@totalCareLogCost.ToString("N0") VNĐ</strong>
                            </div>
                        }
                        else
                        {
                            <partial name="_EmptyState" model="emptyCare" />
                        }
                    </div>

                    @* ==================== Tab: Giá ==================== *@
                    <div class="tab-pane fade" id="price" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0"><i class="bi bi-currency-dollar text-primary me-2"></i>Lịch sử giá</h6>
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addPriceModal">
                                <i class="bi bi-plus-lg me-1"></i>Thêm giá
                            </button>
                        </div>
                        @if (currentPrice != null)
                        {
                            <div class="alert alert-success d-flex align-items-center mb-4">
                                <div class="bg-success-subtle text-success rounded p-3 me-3">
                                    <i class="bi bi-tag-fill fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">Giá hiện tại</h6>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fs-3 fw-bold text-success">@currentPrice.Price.ToString("N0")</span>
                                        <span class="text-muted">VNĐ / @currentPrice.Unit</span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (priceHistory.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Giá</th>
                                            <th>Đơn vị</th>
                                            <th>Ngày áp dụng</th>
                                            <th>Trạng thái</th>
                                            <th width="100">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var price in priceHistory.OrderByDescending(p => p.EffectiveDate))
                                        {
                                            <tr class="@(price.IsActive ? "table-success" : "")">
                                                <td><strong>@price.Price.ToString("N0") VNĐ</strong></td>
                                                <td>@price.Unit</td>
                                                <td>@price.EffectiveDate.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    @if (price.IsActive)
                                                    {
                                                        <span class="badge bg-success">Đang áp dụng</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Không hoạt động</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-primary" title="Sửa"
                                                                onclick="editPrice(@price.Id, @price.Price, '@price.Unit', '@price.EffectiveDate.ToString("yyyy-MM-dd")', '@(price.ExpiryDate?.ToString("yyyy-MM-dd") ?? "")', '@(price.Note?.Replace("'", "\\'") ?? "")', @price.IsActive.ToString().ToLower())">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger" title="Xóa"
                                                                onclick="confirmDeletePrice(@price.Id, @price.Price)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <partial name="_EmptyState" model="emptyPrice" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ==================== Right Column - Sidebar ==================== *@
    <div class="col-lg-4">
        @* Status Card *@
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-speedometer2 text-primary me-2"></i>Trạng thái</h6>
            </div>
            <div class="card-body text-center">
                @{
                    var statusIcon = Model.CropStatusName switch
                    {
                        var s when s?.Contains("Thu hoạch") == true => "bi-check-circle text-success",
                        var s when s?.Contains("Đang") == true => "bi-tree text-primary",
                        _ => "bi-hourglass-split text-warning"
                    };
                }
                <i class="bi @statusIcon mb-3" style="font-size: 3rem;"></i>
                <h5 class="mb-1">@Model.CropStatusName</h5>
                <p class="text-muted mb-0">Đã trồng @daysPlanted ngày</p>
            </div>
        </div>

        @* Current Price Card *@
        <div class="card mb-4 @(currentPrice != null ? "border-success" : "border-warning")">
            <div class="card-header @(currentPrice != null ? "bg-success-subtle border-success" : "bg-warning-subtle border-warning")">
                <h6 class="mb-0 fw-semibold @(currentPrice != null ? "text-success" : "text-warning")">
                    <i class="bi bi-currency-dollar me-2"></i>Giá hiện tại
                </h6>
            </div>
            <div class="card-body text-center">
                @if (currentPrice != null)
                {
                    <div class="display-6 fw-bold text-success mb-1">@currentPrice.Price.ToString("N0")</div>
                    <div class="text-muted">VNĐ / @currentPrice.Unit</div>
                }
                else
                {
                    <div class="text-warning mb-2"><i class="bi bi-exclamation-circle fs-1"></i></div>
                    <p class="text-muted mb-2">Chưa có giá</p>
                    <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#addPriceModal">
                        <i class="bi bi-plus-lg me-1"></i>Thêm giá
                    </button>
                }
            </div>
        </div>

        @* Location Card *@
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-geo-alt text-primary me-2"></i>Vị trí</h6>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary rounded p-3">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <strong class="d-block">@Model.LocationName</strong>
                        <small class="text-muted">Mã vị trí: @Model.LocationId</small>
                    </div>
                </div>
            </div>
        </div>

        @* Statistics Card *@
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart text-primary me-2"></i>Thống kê</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Ngày trồng</span>
                        <strong>@Model.PlantDate.ToString("dd/MM/yyyy")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Số ngày đã trồng</span>
                        <strong>@daysPlanted ngày</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Số lần thu hoạch</span>
                        <strong>@harvests.Count</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Số khoản chi phí</span>
                        <strong>@costs.Count</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Số lần chăm sóc</span>
                        <strong>@careLogs.Count</strong>
                    </li>
                </ul>
            </div>
        </div>

        @* Metadata Card *@
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-info-circle text-primary me-2"></i>Metadata</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">ID</small>
                    <strong>@Model.Id</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày tạo</small>
                    <strong>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                @if (Model.UpdatedDate.HasValue)
                {
                    <div>
                        <small class="text-muted d-block">Cập nhật lần cuối</small>
                        <strong>@Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

