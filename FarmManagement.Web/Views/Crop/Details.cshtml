@model FarmManagement.Application.DTOs.Crops.CropDto
@using FarmManagement.Application.DTOs.Crops

@{
    ViewData["Title"] = "Chi tiết cây trồng";
    ViewData["Breadcrumb"] = "Chi tiết cây trồng";

    var daysPlanted = (DateTime.Today - Model.PlantDate).Days;
    var daysToHarvest = Model.ExpectedHarvestDate.HasValue
      ? (Model.ExpectedHarvestDate.Value - DateTime.Today).Days
        : (int?)null;
    var progress = Model.ExpectedHarvestDate.HasValue
        ? Math.Min(100, Math.Max(0, (int)((double)daysPlanted / (Model.ExpectedHarvestDate.Value - Model.PlantDate).Days * 100)))
    : 0;

    var priceHistory = ViewBag.PriceHistory as List<CropPriceDto> ?? new List<CropPriceDto>();
    var currentPrice = priceHistory.FirstOrDefault(p => p.IsActive);
    var harvests = ViewBag.Harvests as List<CropHarvestDto> ?? new List<CropHarvestDto>();
    var costs = ViewBag.Costs as List<CropCostDto> ?? new List<CropCostDto>();
    var careLogs = ViewBag.CareLogs as List<CropCareLogDto> ?? new List<CropCareLogDto>();
    var costTypes = ViewBag.CostTypes as List<CostTypeDto> ?? new List<CostTypeDto>();
    var careTypes = ViewBag.CareTypes as List<CropCareTypeDto> ?? new List<CropCareTypeDto>();

    var totalHarvestAmount = harvests.Sum(h => h.TotalAmount);
    var totalCostAmount = costs.Sum(c => c.TotalAmount);
    var totalCareLogCost = careLogs.Sum(c => c.Cost);
    var profit = totalHarvestAmount - totalCostAmount - totalCareLogCost;
}

<div class="page-header mb-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
     <li class="breadcrumb-item">
         <a asp-controller="Crop" asp-action="Index">Cây trồng</a>
            </li>
            <li class="breadcrumb-item active">Chi tiết</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-start">
     <div>
  <h1 class="page-title">@Model.Name</h1>
         <p class="page-subtitle mb-0">
    <span class="badge bg-info bg-opacity-10 text-info me-2">@Model.CropTypeName</span>
    <i class="bi bi-geo-alt text-muted me-1"></i>@Model.LocationName
        </p>
    </div>
      <div class="page-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
         <i class="bi bi-pencil me-1"></i>Sửa
   </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
     <i class="bi bi-arrow-left me-1"></i>Quay lại
         </a>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
 <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
  <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
  @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
     <div class="stats-card">
         <div class="d-flex align-items-center justify-content-between">
             <div>
                    <div class="stats-card-value text-success">@totalHarvestAmount.ToString("N0")</div>
         <div class="stats-card-label">Doanh thu (VNĐ)</div>
          </div>
     <div class="stats-card-icon success">
  <i class="bi bi-basket"></i>
     </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
    <div class="d-flex align-items-center justify-content-between">
        <div>
             <div class="stats-card-value text-danger">@((totalCostAmount + totalCareLogCost).ToString("N0"))</div>
 <div class="stats-card-label">Chi phí (VNĐ)</div>
    </div>
   <div class="stats-card-icon danger">
         <i class="bi bi-wallet2"></i>
   </div>
       </div>
   </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
  <div class="d-flex align-items-center justify-content-between">
           <div>
  <div class="stats-card-value @(profit >= 0 ? "text-primary" : "text-danger")">@profit.ToString("N0")</div>
                    <div class="stats-card-label">Lợi nhuận (VNĐ)</div>
         </div>
              <div class="stats-card-icon @(profit >= 0 ? "primary" : "danger")">
<i class="bi bi-graph-up-arrow"></i>
  </div>
            </div>
     </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stats-card">
    <div class="d-flex align-items-center justify-content-between">
      <div>
   <div class="stats-card-value">@careLogs.Count</div>
         <div class="stats-card-label">Lần chăm sóc</div>
           </div>
        <div class="stats-card-icon warning">
   <i class="bi bi-calendar-check"></i>
        </div>
      </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái - Tabs chức năng -->
    <div class="col-lg-8">
        <!-- Thông tin cây trồng -->
        <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
           <h5 class="card-title mb-0">
        <i class="bi bi-flower2 me-2"></i>Thông tin cây trồng
      </h5>
      <span class="badge badge-status @(Model.ActualHarvestDate.HasValue ? "badge-active" : "bg-primary")">
     @Model.CropStatusName
      </span>
   </div>
            <div class="card-body">
          @if (!Model.ActualHarvestDate.HasValue && Model.ExpectedHarvestDate.HasValue)
       {
  <div class="mb-4">
   <div class="d-flex justify-content-between mb-2">
      <span class="fw-medium">Tiến độ sinh trưởng</span>
 <span class="text-muted">@progress%</span>
              </div>
 <div class="progress" style="height: 10px;">
             <div class="progress-bar @(progress >= 90 ? "bg-success" : progress >= 50 ? "bg-primary" : "bg-warning")"
            role="progressbar" style="width: @progress%;">
             </div>
      </div>
      <small class="text-muted">
      @if (daysToHarvest.HasValue && daysToHarvest > 0)
            {
       <text>Còn @daysToHarvest ngày đến ngày dự kiến thu hoạch</text>
          }
       else if (daysToHarvest.HasValue && daysToHarvest <= 0)
           {
        <span class="text-danger">Đã quá hạn thu hoạch @Math.Abs(daysToHarvest.Value) ngày</span>
              }
         </small>
         </div>
      }

         <div class="row g-3">
        <div class="col-md-6">
       <div class="border rounded p-3">
     <div class="d-flex align-items-center mb-2">
              <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
   <i class="bi bi-calendar-event"></i>
       </div>
           <div>
          <small class="text-muted d-block">Ngày trồng</small>
  <strong>@Model.PlantDate.ToString("dd/MM/yyyy")</strong>
            </div>
       </div>
            <small class="text-muted">@daysPlanted ngày trước</small>
       </div>
        </div>
      <div class="col-md-6">
              <div class="border rounded p-3">
           <div class="d-flex align-items-center mb-2">
          <div class="bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
  <i class="bi bi-calendar-check"></i>
  </div>
      <div>
               <small class="text-muted d-block">Dự kiến thu hoạch</small>
         <strong>
                 @if (Model.ExpectedHarvestDate.HasValue)
     {
    @Model.ExpectedHarvestDate.Value.ToString("dd/MM/yyyy")
             }
   else
             {
             <span class="text-muted">Chưa xác định</span>
  }
           </strong>
                </div>
     </div>
       </div>
 </div>
  <div class="col-md-6">
     <div class="border rounded p-3">
                   <div class="d-flex align-items-center">
     <div class="bg-info bg-opacity-10 text-info rounded p-2 me-3">
     <i class="bi bi-basket"></i>
         </div>
     <div>
     <small class="text-muted d-block">Năng suất dự kiến</small>
  <strong>
                 @if (Model.EstimatedYield.HasValue)
    {
                   @Model.EstimatedYield.Value.ToString("N0") @Model.Unit
    }
    else
             {
               <span class="text-muted">Chưa xác định</span>
    }
            </strong>
    </div>
      </div>
            </div>
        </div>
      @if (currentPrice != null)
                {
        <div class="col-md-6">
 <div class="border rounded p-3 border-success">
     <div class="d-flex align-items-center">
   <div class="bg-success bg-opacity-10 text-success rounded p-2 me-3">
               <i class="bi bi-currency-dollar"></i>
           </div>
             <div>
           <small class="text-muted d-block">Giá hiện tại</small>
     <strong class="text-success">@currentPrice.Price.ToString("N0") VNĐ/@currentPrice.Unit</strong>
     </div>
    </div>
     </div>
        </div>
            }
</div>

          @if (!string.IsNullOrEmpty(Model.Note))
          {
                 <div class="mt-4 p-3 bg-light rounded">
     <h6 class="mb-2"><i class="bi bi-sticky me-2"></i>Ghi chú</h6>
            <p class="mb-0">@Model.Note</p>
        </div>
        }
            </div>
        </div>

        <!-- Tabs quản lý -->
        <div class="card">
<div class="card-header">
          <ul class="nav nav-tabs card-header-tabs" id="cropTabs" role="tablist">
                    <li class="nav-item" role="presentation">
       <button class="nav-link active" id="harvest-tab" data-bs-toggle="tab" data-bs-target="#harvest" type="button">
              <i class="bi bi-basket me-1"></i>Thu hoạch <span class="badge bg-success ms-1">@harvests.Count</span>
    </button>
   </li>
              <li class="nav-item" role="presentation">
            <button class="nav-link" id="cost-tab" data-bs-toggle="tab" data-bs-target="#cost" type="button">
        <i class="bi bi-wallet2 me-1"></i>Chi phí <span class="badge bg-danger ms-1">@costs.Count</span>
       </button>
     </li>
  <li class="nav-item" role="presentation">
         <button class="nav-link" id="care-tab" data-bs-toggle="tab" data-bs-target="#care" type="button">
          <i class="bi bi-calendar-check me-1"></i>Chăm sóc <span class="badge bg-warning text-dark ms-1">@careLogs.Count</span>
           </button>
       </li>
         <li class="nav-item" role="presentation">
         <button class="nav-link" id="price-tab" data-bs-toggle="tab" data-bs-target="#price" type="button">
                   <i class="bi bi-currency-dollar me-1"></i>Giá <span class="badge bg-info ms-1">@priceHistory.Count</span>
  </button>
     </li>
           </ul>
          </div>
 <div class="card-body">
            <div class="tab-content" id="cropTabsContent">
             <!-- Tab Thu hoạch -->
      <div class="tab-pane fade show active" id="harvest" role="tabpanel">
           <div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="mb-0"><i class="bi bi-basket me-2"></i>Danh sách thu hoạch</h6>
             <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addHarvestModal">
       <i class="bi bi-plus-lg me-1"></i>Thêm thu hoạch
          </button>
        </div>
       @if (harvests.Any())
     {
         <div class="table-responsive">
         <table class="table table-hover mb-0">
        <thead class="table-light">
       <tr>
              <th>Ngày</th>
     <th>Số lượng</th>
       <th>Đơn giá</th>
                  <th>Tổng tiền</th>
      <th>Người mua</th>
    <th width="100">Thao tác</th>
        </tr>
       </thead>
           <tbody>
    @foreach (var h in harvests.OrderByDescending(x => x.HarvestDate))
         {
               <tr>
            <td>@h.HarvestDate.ToString("dd/MM/yyyy")</td>
  <td>@h.Quantity.ToString("N2") @h.Unit</td>
  <td>@h.UnitPrice.ToString("N0") VNĐ</td>
          <td><strong class="text-success">@h.TotalAmount.ToString("N0") VNĐ</strong></td>
    <td>@(h.Buyer ?? "-")</td>
    <td>
             <div class="btn-group btn-group-sm">
   <button type="button" class="btn btn-outline-primary" title="Sửa"
          onclick="editHarvest(@h.Id, '@h.HarvestDate.ToString("yyyy-MM-dd")', @h.Quantity, '@(h.Unit ?? "")', @h.UnitPrice, '@(h.Buyer ?? "")', '@(h.Note?.Replace("'", "\\'") ?? "")')">
     <i class="bi bi-pencil"></i>
      </button>
             <button type="button" class="btn btn-outline-danger" title="Xóa"
         onclick="confirmDeleteHarvest(@h.Id, '@h.HarvestDate.ToString("dd/MM/yyyy")')">
         <i class="bi bi-trash"></i>
        </button>
               </div>
      </td>
                  </tr>
           }
              </tbody>
      <tfoot class="table-light">
           <tr>
         <td colspan="3" class="text-end"><strong>Tổng cộng:</strong></td>
          <td colspan="3"><strong class="text-success">@totalHarvestAmount.ToString("N0") VNĐ</strong></td>
           </tr>
           </tfoot>
     </table>
      </div>
         }
      else
     {
         <div class="text-center py-4 text-muted">
            <i class="bi bi-basket" style="font-size: 2rem;"></i>
       <p class="mt-2 mb-0">Chưa có thông tin thu hoạch</p>
         </div>
      }
</div>

       <!-- Tab Chi phí -->
        <div class="tab-pane fade" id="cost" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="mb-0"><i class="bi bi-wallet2 me-2"></i>Danh sách chi phí</h6>
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#addCostModal">
        <i class="bi bi-plus-lg me-1"></i>Thêm chi phí
          </button>
         </div>
         @if (costs.Any())
         {
         <div class="table-responsive">
      <table class="table table-hover mb-0">
                <thead class="table-light">
<tr>
        <th>Ngày</th>
    <th>Loại chi phí</th>
     <th>Số lượng</th>
 <th>Đơn giá</th>
<th>Tổng tiền</th>
           <th width="100">Thao tác</th>
</tr>
            </thead>
     <tbody>
           @foreach (var c in costs.OrderByDescending(x => x.CostDate))
 {
                <tr>
     <td>@c.CostDate.ToString("dd/MM/yyyy")</td>
   <td><span class="badge bg-secondary">@c.CostTypeName</span></td>
  <td>@c.Quantity.ToString("N2") @c.Unit</td>
     <td>@c.UnitPrice.ToString("N0") VNĐ</td>
          <td><strong class="text-danger">@c.TotalAmount.ToString("N0") VNĐ</strong></td>
      <td>
       <div class="btn-group btn-group-sm">
              <button type="button" class="btn btn-outline-primary" title="Sửa"
      onclick="editCost(@c.Id, @c.CostTypeId, '@c.CostDate.ToString("yyyy-MM-dd")', @c.Quantity, '@(c.Unit ?? "")', @c.UnitPrice, '@(c.Note?.Replace("'", "\\'") ?? "")')">
         <i class="bi bi-pencil"></i>
     </button>
     <button type="button" class="btn btn-outline-danger" title="Xóa"
     onclick="confirmDeleteCost(@c.Id, '@c.CostTypeName')">
            <i class="bi bi-trash"></i>
 </button>
   </div>
       </td>
      </tr>
        }
      </tbody>
       <tfoot class="table-light">
           <tr>
  <td colspan="4" class="text-end"><strong>Tổng cộng:</strong></td>
         <td colspan="2"><strong class="text-danger">@totalCostAmount.ToString("N0") VNĐ</strong></td>
          </tr>
       </tfoot>
    </table>
                </div>
              }
       else
            {
    <div class="text-center py-4 text-muted">
                <i class="bi bi-wallet2" style="font-size: 2rem;"></i>
               <p class="mt-2 mb-0">Chưa có chi phí nào được ghi nhận</p>
      </div>
          }
   </div>

        <!-- Tab Chăm sóc -->
        <div class="tab-pane fade" id="care" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Nhật ký chăm sóc</h6>
          <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#addCareLogModal">
           <i class="bi bi-plus-lg me-1"></i>Thêm chăm sóc
          </button>
       </div>
    @if (careLogs.Any())
      {
     <div class="care-timeline">
     @foreach (var log in careLogs.OrderByDescending(x => x.CareDate))
                  {
          var iconClass = log.CropCareTypeName switch
       {
 var n when n?.Contains("Tưới") == true => "bi-droplet text-info",
var n when n?.Contains("Bón") == true => "bi-flower3 text-success",
        var n when n?.Contains("Phun") == true => "bi-bug text-warning",
               var n when n?.Contains("Làm cỏ") == true => "bi-scissors text-secondary",
                 _ => "bi-calendar-event text-primary"
                 };
           <div class="care-item d-flex mb-3 p-3 border rounded">
         <div class="care-icon bg-light rounded-circle p-2 me-3">
      <i class="bi @iconClass"></i>
         </div>
  <div class="flex-grow-1">
         <div class="d-flex justify-content-between align-items-start">
        <div>
     <strong>@log.CropCareTypeName</strong>
           <small class="text-muted d-block">@log.CareDate.ToString("dd/MM/yyyy")</small>
 </div>
 <div class="d-flex align-items-center gap-2">
   @if (log.Cost > 0)
   {
            <span class="badge bg-danger">@log.Cost.ToString("N0") VNĐ</span>
        }
  <div class="btn-group btn-group-sm">
    <button type="button" class="btn btn-outline-primary btn-sm" title="Sửa"
    onclick="editCareLog(@log.Id, @log.CropCareTypeId, '@log.CareDate.ToString("yyyy-MM-dd")', '@(log.Description?.Replace("'", "\\'") ?? "")', @log.Cost)">
        <i class="bi bi-pencil"></i>
      </button>
     <button type="button" class="btn btn-outline-danger btn-sm" title="Xóa"
     onclick="confirmDeleteCareLog(@log.Id, '@log.CropCareTypeName')">
  <i class="bi bi-trash"></i>
              </button>
     </div>
    </div>
</div>
     @if (!string.IsNullOrEmpty(log.Description))
   {
     <small class="text-muted mt-1 d-block">@log.Description</small>
    }
            </div>
      </div>
   }
 </div>
         <div class="alert alert-info mt-3">
          <i class="bi bi-info-circle me-2"></i>
    Tổng chi phí chăm sóc: <strong>@totalCareLogCost.ToString("N0") VNĐ</strong>
                 </div>
       }
          else
            {
       <div class="text-center py-4 text-muted">
    <i class="bi bi-calendar-check" style="font-size: 2rem;"></i>
          <p class="mt-2 mb-0">Chưa có nhật ký chăm sóc</p>
    </div>
      }
           </div>

     <!-- Tab Giá -->
 <div class="tab-pane fade" id="price" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="mb-0"><i class="bi bi-currency-dollar me-2"></i>Lịch sử giá</h6>
      <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addPriceModal">
   <i class="bi bi-plus-lg me-1"></i>Thêm giá
         </button>
   </div>
         @if (currentPrice != null)
    {
    <div class="alert alert-success d-flex align-items-center mb-4">
  <div class="bg-success bg-opacity-10 text-success rounded p-3 me-3">
             <i class="bi bi-tag-fill" style="font-size: 1.5rem;"></i>
              </div>
      <div class="flex-grow-1">
         <h5 class="mb-1">Giá hiện tại</h5>
           <div class="d-flex align-items-baseline gap-2">
         <span class="fs-3 fw-bold text-success">@currentPrice.Price.ToString("N0")</span>
              <span class="text-muted">VNĐ / @currentPrice.Unit</span>
     </div>
      </div>
    </div>
        }
@if (priceHistory.Any())
{
          <div class="table-responsive">
      <table class="table table-hover mb-0">
   <thead class="table-light">
     <tr>
      <th>Giá</th>
           <th>Đơn vị</th>
         <th>Ngày áp dụng</th>
           <th>Trạng thái</th>
         <th width="100">Thao tác</th>
               </tr>
      </thead>
       <tbody>
   @foreach (var price in priceHistory.OrderByDescending(p => p.EffectiveDate))
       {
    <tr class="@(price.IsActive ? "table-success" : "")">
    <td><strong>@price.Price.ToString("N0") VNĐ</strong></td>
       <td>@price.Unit</td>
        <td>@price.EffectiveDate.ToString("dd/MM/yyyy")</td>
             <td>
      @if (price.IsActive)
      {
           <span class="badge bg-success">Đang áp dụng</span>
       }
              else
          {
         <span class="badge bg-secondary">Không hoạt động</span>
        }
      </td>
             <td>
       <div class="btn-group btn-group-sm">
              <button type="button" class="btn btn-outline-primary" title="Sửa"
       onclick="editPrice(@price.Id, @price.Price, '@price.Unit', '@price.EffectiveDate.ToString("yyyy-MM-dd")', '@(price.ExpiryDate?.ToString("yyyy-MM-dd") ?? "")', '@(price.Note?.Replace("'", "\\'") ?? "")', @price.IsActive.ToString().ToLower())">
     <i class="bi bi-pencil"></i>
          </button>
 <button type="button" class="btn btn-outline-danger" title="Xóa"
           onclick="confirmDeletePrice(@price.Id, @price.Price)">
     <i class="bi bi-trash"></i>
           </button>
  </div>
     </td>
              </tr>
    }
              </tbody>
              </table>
               </div>
  }
       else
            {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-currency-dollar" style="font-size: 2rem;"></i>
     <p class="mt-2 mb-0">Chưa có lịch sử giá</p>
          </div>
       }
  </div>
         </div>
            </div>
        </div>
    </div>

    <!-- Cột phải - Thông tin bổ sung -->
    <div class="col-lg-4">
        <div class="card mb-4">
   <div class="card-header">
      <h5 class="card-title mb-0"><i class="bi bi-speedometer2 me-2"></i>Trạng thái</h5>
     </div>
          <div class="card-body text-center">
