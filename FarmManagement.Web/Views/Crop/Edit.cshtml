@model FarmManagement.Application.DTOs.Crops.UpdateCropDto
@using FarmManagement.Application.DTOs.Crops
@using FarmManagement.Application.DTOs.Locations

@{
    ViewData["Title"] = "Sửa cây trồng";
    ViewData["Breadcrumb"] = "Sửa cây trồng";

    var cropTypes = ViewBag.CropTypes as List<CropTypeDto> ?? new List<CropTypeDto>();
    var cropStatuses = ViewBag.CropStatuses as IEnumerable<CropStatusDto> ?? new List<CropStatusDto>();
    var locations = ViewBag.Locations as List<LocationDto> ?? new List<LocationDto>();
    var cropDto = ViewBag.CropDto as CropDto;
}

<div class="page-header mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Crop" asp-action="Index">Cây trồng</a>
            </li>
            <li class="breadcrumb-item active">Sửa</li>
        </ol>
    </nav>
    <h1 class="page-title">Sửa cây trồng</h1>
    <p class="page-subtitle">Cập nhật thông tin cây trồng #@Model.Id</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-lg-8">
            <!-- Thông tin cơ bản -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-flower2 me-2"></i>Thông tin cơ bản
                    </h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">
                                <i class="bi bi-tag me-1"></i>Tên cây trồng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CropTypeId" class="form-label">
                                <i class="bi bi-flower1 me-1"></i>Loại cây trồng <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CropTypeId" class="form-select">
                                <option value="">-- Chọn loại cây --</option>
                                @foreach (var ct in cropTypes)
                                {
                                    <option value="@ct.Id">@ct.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CropTypeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LocationId" class="form-label">
                                <i class="bi bi-geo-alt me-1"></i>Vị trí trồng <span class="text-danger">*</span>
                            </label>
                            <select asp-for="LocationId" class="form-select">
                                <option value="">-- Chọn vị trí --</option>
                                @foreach (var loc in locations)
                                {
                                    <option value="@loc.Id">@loc.Name</option>
                                }
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CropStatusId" class="form-label">
                                <i class="bi bi-heart-pulse me-1"></i>Trạng thái <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CropStatusId" class="form-select">
                                <option value="">-- Chọn trạng thái --</option>
                                @foreach (var cs in cropStatuses)
                                {
                                    <option value="@cs.Id">@cs.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CropStatusId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PlantDate" class="form-label">
                                <i class="bi bi-calendar-event me-1"></i>Ngày trồng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="PlantDate" type="date" class="form-control" />
                            <span asp-validation-for="PlantDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin năng suất & thu hoạch -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-graph-up me-2"></i>Thông tin năng suất & thu hoạch
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ExpectedHarvestDate" class="form-label">
                                <i class="bi bi-calendar-check me-1"></i>Ngày dự kiến thu hoạch
                            </label>
                            <input asp-for="ExpectedHarvestDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedHarvestDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActualHarvestDate" class="form-label">
                                <i class="bi bi-calendar-heart me-1"></i>Ngày thu hoạch thực tế
                            </label>
                            <input asp-for="ActualHarvestDate" type="date" class="form-control" />
                            <span asp-validation-for="ActualHarvestDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EstimatedYield" class="form-label">
                                <i class="bi bi-basket me-1"></i>Năng suất dự kiến
                            </label>
                            <input asp-for="EstimatedYield" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="EstimatedYield" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Unit" class="form-label">
                                <i class="bi bi-rulers me-1"></i>Đơn vị
                            </label>
                            <input asp-for="Unit" class="form-control" />
                            <span asp-validation-for="Unit" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                <i class="bi bi-currency-dollar me-1"></i>Giá hiện tại
                            </label>
                            <input type="text" class="form-control" readonly
                                   value="@(cropDto?.CurrentPrice?.ToString("N0") ?? "Chưa có") VNĐ" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Note" class="form-label">
                                <i class="bi bi-sticky me-1"></i>Ghi chú
                            </label>
                            <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Note" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Thao tác -->
            <div class="card sticky-top" style="top: 80px;">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>Thao tác
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Cập nhật
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                            <i class="bi bi-eye me-1"></i>Xem chi tiết
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Hủy
                        </a>
                    </div>
                </div>
            </div>

            <!-- Thông tin -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Thông tin
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block">ID</small>
                        <strong>@Model.Id</strong>
                    </div>
                    @if (cropDto?.CreatedDate != null)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Ngày tạo</small>
                            <strong>@cropDto.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    }
                    @if (cropDto?.UpdatedDate != null)
                    {
                        <div>
                            <small class="text-muted d-block">Cập nhật lần cuối</small>
                            <strong>@cropDto.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Vùng nguy hiểm -->
            <div class="card border-danger mt-3">
                <div class="card-header bg-danger bg-opacity-10 border-danger">
                    <h5 class="card-title mb-0 text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>Vùng nguy hiểm
                    </h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">Các thao tác không thể hoàn tác</p>
                    <button type="button" class="btn btn-outline-danger btn-sm w-100"
                            onclick="confirmDelete(@Model.Id, '@Model.Name')">
                        <i class="bi bi-trash me-1"></i>Xóa cây trồng này
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Delete Form (hidden) -->
<form id="deleteForm" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa cây trồng <strong id="deleteItemName"></strong>?</p>
                <p class="text-muted small mb-0">Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="submitDelete()">
                    <i class="bi bi-trash me-1"></i>Xóa
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
              function confirmDelete(id, name) {
                document.getElementById('deleteItemName').textContent = name;
                  document.getElementById('deleteId').value = id;
          new bootstrap.Modal(document.getElementById('deleteModal')).show();
           }

        function submitDelete() {
                  document.getElementById('deleteForm').submit();
              }
    </script>
}
