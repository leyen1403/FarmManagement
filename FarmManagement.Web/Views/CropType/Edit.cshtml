@model FarmManagement.Application.DTOs.Crops.UpdateCropTypeDto

@{
    ViewData["Title"] = "Sửa loại cây trồng";

    // Cấu hình Breadcrumbs
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        new BreadcrumbItem("Loại cây trồng", "/CropType", "bi bi-flower1"),
        BreadcrumbItem.Current("Chỉnh sửa")
    );

    // Cấu hình Page Header
    var pageHeader = new PageHeaderModel
    {
        Title = "Sửa loại cây trồng",
        Subtitle = $"Cập nhật thông tin chi tiết cho bản ghi #{Model.Id}",
        Icon = "bi bi-flower1",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            ActionButtonModel.Back("/CropType", "Quay lại danh sách")
        }
    };
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

<div class="row g-4">
    @* ==================== Main Form: Cập nhật dữ liệu ==================== *@
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="card-title mb-0 fw-semibold text-dark">
                    <i class="bi bi-pencil-square text-success me-2"></i>Thông tin loại cây trồng
                </h6>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    @* Thông báo lỗi tổng quát *@
                    <div asp-validation-summary="All" class="alert alert-danger alert-dismissible fade show"
                         style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <div class="row g-4">
                        @* Mã loại cây (Chỉ đọc) *@
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label fw-medium">
                                <i class="bi bi-hash me-1 text-muted"></i>Mã loại cây
                            </label>
                            <input asp-for="Code" class="form-control bg-light" readonly
                                   title="Mã hệ thống không thể thay đổi sau khi tạo" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                            <div class="form-text small">Mã định danh không được phép thay đổi</div>
                        </div>

                        @* Tên loại cây *@
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-medium">
                                <i class="bi bi-tag me-1 text-muted"></i>Tên loại cây <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên loại cây..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        @* Mô tả *@
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-medium">
                                <i class="bi bi-text-paragraph me-1 text-muted"></i>Mô tả chi tiết
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Cập nhật mô tả mới cho loại cây này..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        @* Switch: Trạng thái hoạt động *@
                        <div class="col-12">
                            <div class="form-check form-switch p-3 border rounded bg-light bg-opacity-50">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                                <label asp-for="IsActive" class="form-check-label ms-2 fw-medium" for="isActiveSwitch">
                                    <i class="bi bi-power me-1"></i>Trạng thái hoạt động
                                </label>
                                <div class="form-text ms-1 mt-1 small">Tắt để ngừng sử dụng loại cây này trong các vụ mùa mới</div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 opacity-25">

                    @* Nhóm nút thao tác *@
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-save me-1"></i>Lưu cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-lg me-1"></i>Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ==================== Sidebar: Thông tin & Vùng nguy hiểm ==================== *@
    <div class="col-lg-4">
        @* Card: Thông tin tóm tắt *@
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi bi-info-circle text-success me-2"></i>Thông tin hệ thống
                </h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted small">ID bản ghi</span>
                    <span class="fw-bold text-dark">#@Model.Id</span>
                </div>
                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                    <span class="text-muted small">Mã định danh</span>
                    <code class="text-success fw-bold">@Model.Code</code>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Tình trạng</span>
                    @if (Model.IsActive)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3">
                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3">
                            <i class="bi bi-x-circle-fill me-1"></i>Ngưng sử dụng
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Card: Danger Zone (Xóa) *@
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger-subtle border-danger py-3">
                <h6 class="card-title mb-0 text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle me-2"></i>Vùng nguy hiểm
                </h6>
            </div>
            <div class="card-body bg-danger bg-opacity-10">
                <p class="small text-danger-emphasis mb-3">
                    Hành động xóa sẽ gỡ bỏ hoàn toàn loại cây này khỏi hệ thống. Việc này có thể ảnh hưởng đến lịch sử canh tác liên quan.
                </p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn xóa loại cây trồng này? Hành động này không thể hoàn tác!');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-2 fw-medium">
                        <i class="bi bi-trash me-1"></i>Xóa loại cây này
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* Custom Subscriptions Colors */
    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.08) !important;
    }

    .bg-secondary-subtle {
        background-color: rgba(108, 117, 125, 0.08) !important;
    }

    .bg-danger-subtle {
        background-color: rgba(220, 53, 69, 0.08) !important;
    }

    /* Animation cho card nguy hiểm */
    .card.border-danger:hover {
        border-color: #dc3545 !important;
        transition: all 0.3s ease;
    }
</style>