@model FarmManagement.Application.DTOs.Crops.CreateCropTypeDto

@{
    ViewData["Title"] = "Thêm loại cây trồng";

    // Cấu hình Breadcrumbs sử dụng Extension Method của hệ thống
    ViewData.SetBreadcrumbs(
        BreadcrumbItem.Home(),
        new BreadcrumbItem("Loại cây trồng", "/CropType", "bi bi-flower1"),
        BreadcrumbItem.Current("Thêm mới")
    );

    // Cấu hình Page Header Component
    var pageHeader = new PageHeaderModel
    {
        Title = "Thêm loại cây trồng",
        Subtitle = "Tạo loại cây trồng mới trong hệ thống quản lý",
        Icon = "bi bi-flower1",
        ShowBreadcrumb = false,
        Actions = new List<ActionButtonModel>
        {
            ActionButtonModel.Back("/CropType", "Quay lại")
        }
    };
}

@* ==================== Page Header ==================== *@
<partial name="_PageHeader" model="pageHeader" />

<div class="row g-4">
    @* ==================== Main Form: Nhập liệu ==================== *@
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="card-title mb-0 fw-semibold text-dark">
                    <i class="bi bi-pencil-square text-success me-2"></i>Thông tin loại cây trồng
                </h6>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    @* Hiển thị lỗi tổng hợp từ ModelState *@
                    <div asp-validation-summary="All" class="alert alert-danger"
                         style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
                    </div>

                    <div class="row g-4">
                        @* Mã loại cây (Tùy chọn) *@
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label fw-medium">
                                <i class="bi bi-hash me-1 text-muted"></i>Mã loại cây <span class="text-muted fw-normal">(tùy chọn)</span>
                            </label>
                            <input asp-for="Code" class="form-control" placeholder="VD: RICE, CORN..." />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                            <div class="form-text mt-2 text-muted small">Nếu để trống, hệ thống sẽ tự động tạo mã định danh</div>
                        </div>

                        @* Tên loại cây (Bắt buộc) *@
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-medium">
                                <i class="bi bi-tag me-1 text-muted"></i>Tên loại cây <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="VD: Lúa nước" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        @* Mô tả chi tiết *@
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-medium">
                                <i class="bi bi-text-paragraph me-1 text-muted"></i>Mô tả chi tiết
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Mô tả đặc điểm hoặc ghi chú về loại cây trồng này..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4 opacity-25">

                    @* Các nút thao tác *@
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-lg me-1"></i>Lưu thông tin
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-lg me-1"></i>Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ==================== Sidebar: Hướng dẫn & Gợi ý ==================== *@
    <div class="col-lg-4">
        <div class="card bg-success-subtle border-success shadow-sm">
            <div class="card-header bg-transparent border-success py-3">
                <h6 class="card-title mb-0 text-success fw-bold">
                    <i class="bi bi-lightbulb me-2"></i>Mẹo nhỏ cho bạn
                </h6>
            </div>
            <div class="card-body">
                <p class="mb-3 text-dark small">Phân loại cây trồng chính xác giúp hệ thống báo cáo sản lượng hiệu quả hơn. Một số ví dụ:</p>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2 d-flex align-items-center">
                        <i class="bi bi-check2-circle text-success me-2"></i>Lúa nước / Lúa cạn
                    </li>
                    <li class="mb-2 d-flex align-items-center">
                        <i class="bi bi-check2-circle text-success me-2"></i>Ngô / Bắp lấy hạt
                    </li>
                    <li class="mb-2 d-flex align-items-center">
                        <i class="bi bi-check2-circle text-success me-2"></i>Rau xanh ngắn ngày
                    </li>
                    <li class="mb-2 d-flex align-items-center">
                        <i class="bi bi-check2-circle text-success me-2"></i>Cây ăn quả lâu năm
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bi bi-check2-circle text-success me-2"></i>Cây công nghiệp
                    </li>
                </ul>
            </div>
        </div>

        <div class="alert alert-info mt-4 border-0 shadow-sm small" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            Thông tin này sẽ được dùng để phân loại cho các <strong>Vụ mùa (Crops)</strong> sau này.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.08) !important;
    }
</style>