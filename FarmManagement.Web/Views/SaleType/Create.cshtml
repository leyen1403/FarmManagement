@model FarmManagement.Application.DTOs.Livestocks.CreateSaleTypeDto
@using FarmManagement.Domain.Entities.Livestocks

@{
    ViewData["Title"] = "Thêm loại bán";
    ViewData["Breadcrumb"] = "Thêm loại bán";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Thêm loại bán</h1>
        <p class="page-subtitle mb-0">Nhập thông tin loại bán vật nuôi mới</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="bi bi-cash-coin me-2"></i>Thông tin loại bán
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label">Mã loại bán <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control" placeholder="VD: PER_HEAD, PER_KG..." />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Tên loại bán <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="VD: Bán theo con, Bán theo kg..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SaleMethod" class="form-label">Phương thức tính tiền <span class="text-danger">*</span></label>
                    <select asp-for="SaleMethod" class="form-select" required>
                        <option value="">-- Chọn phương thức --</option>
                        <option value="@((int)SaleMethod.PerHead)">Theo con (Số lượng × Đơn giá/con)</option>
                        <option value="@((int)SaleMethod.PerKilogram)">Theo kg (Trọng lượng × Đơn giá/kg)</option>
                        <option value="@((int)SaleMethod.PerLot)">Theo lô/đàn (Giá trọn gói)</option>
                        <option value="@((int)SaleMethod.PerSet)">Theo bộ/cặp (Số bộ × Đơn giá/bộ)</option>
                    </select>
                    <span asp-validation-for="SaleMethod" class="text-danger"></span>
                    <small class="text-muted">Phương thức này xác định cách tính tổng tiền khi bán</small>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-lg me-1"></i>Hủy
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
